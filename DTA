// Plot queue for batched rendering
const PlotQueue = {
    pending: [],
    frameId: null,

    add(plotFn, priority = 0) {
        this.pending.push({ fn: plotFn, priority });
        this.schedule();
    },

    schedule() {
        if (this.frameId) return;
        this.frameId = requestAnimationFrame(() => this.flush());
    },

    flush() {
        this.frameId = null;
        // Sort by priority (higher first)
        this.pending.sort((a, b) => b.priority - a.priority);

        const batch = this.pending.splice(0, 3); // Process 3 plots per frame
        batch.forEach(item => {
            try {
                item.fn();
            } catch (e) {
                console.error('Plot error:', e);
            }
        });

        // Continue if more pending
        if (this.pending.length > 0) {
            this.schedule();
        }
    },

    clear() {
        if (this.frameId) {
            cancelAnimationFrame(this.frameId);
            this.frameId = null;
        }
        this.pending = [];
    }
};

