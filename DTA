plot(fit_hsroc, sroclwd = 2, main = "HSROC Curve")
points(fpr(data), sens(data), pch = 19)

# Add confidence region
lines(fit_hsroc, which = "conf.region", col = "blue", lty = 2)
lines(fit_hsroc, which = "pred.region", col = "red", lty = 3)
legend("bottomright",
       legend = c("SROC curve", "${ciPercent}% Conf. region", "Prediction region"),
       col = c("black", "blue", "red"), lty = c(1, 2, 3))
`;
    } else if (modelType === 'univariate') {
        modelCode = `
# ============================================
# Univariate Random Effects Models
# ============================================

# Calculate study-level sensitivity and specificity
sens_data <- madad(data)

# Univariate meta-analysis for sensitivity
library(meta)
sens_meta <- metaprop(TP, TP + FN, studlab = study, data = data,
                      method = "GLMM", sm = "PLOGIT")
summary(sens_meta)

# Univariate meta-analysis for specificity
spec_meta <- metaprop(TN, TN + FP, studlab = study, data = data,
                      method = "GLMM", sm = "PLOGIT")
summary(spec_meta)

# Forest plots for univariate models
forest(sens_meta, main = "Sensitivity - Univariate RE Model")
forest(spec_meta, main = "Specificity - Univariate RE Model")

# Note: Univariate models do NOT account for the correlation
# between sensitivity and specificity. Use bivariate or HSROC
# models for proper inference when possible.
cat("\\nWarning: Univariate models ignore sens-spec correlation\\n")
`;
    } else {
        // Default: bivariate model
        modelCode = `
# ============================================
# Bivariate Random Effects Model (Reitsma)
# ============================================

# Fit bivariate model - accounts for correlation between sens and spec
fit <- reitsma(data, correction.control = "all")
summary(fit)

# Extract variance-covariance matrix
vcov(fit)

# Correlation between logit(sens) and logit(1-spec)
cat("\\nCorrelation:", round(summary(fit)$Psi[1,2] /
    sqrt(summary(fit)$Psi[1,1] * summary(fit)$Psi[2,2]), 3), "\\n")
`;
    }

    const code = `# ============================================
# DTA Meta-Analysis in R
# Generated by DTA Meta-Analysis Suite
# Model: ${modelType.toUpperCase()}
# CI Level: ${ciPercent}%
# ============================================

# Install required packages (run once)
# install.packages(c("mada", "metafor", "meta"))

library(mada)
library(metafor)

# ============================================
# Study Data (${validStudies.length} studies)
# ============================================
data <- data.frame(
