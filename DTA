    const tnValues = validStudies.map(s => s.tn).join(', ');

    const modelType = results.model.modelType || 'bivariate';
    const ciLevel = results.model.ciLevel || 0.95;
    const ciPercent = Math.round(ciLevel * 100);

    let modelCode = '';

    if (modelType === 'hsroc') {
        modelCode = `
