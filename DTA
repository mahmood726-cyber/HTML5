function runBenchmark(numStudies = 50, iterations = 10) {
    console.log(`\n🚀 Running benchmark with ${numStudies} studies, ${iterations} iterations...\n`);
    Perf.clear();

    // Generate synthetic data
    const syntheticStudies = [];
    for (let i = 0; i < numStudies; i++) {
        syntheticStudies.push({
            id: Date.now() + i,
            name: `Study ${i + 1}`,
            tp: Math.floor(Math.random() * 200) + 10,
            fp: Math.floor(Math.random() * 100) + 5,
            fn: Math.floor(Math.random() * 50) + 2,
            tn: Math.floor(Math.random() * 300) + 20,
            quadas: { patient: 'low', index: 'low', reference: 'low', flow: 'low' }
        });
    }

    // Benchmark study stats calculation
    const studyStatsTimes = [];
    for (let i = 0; i < iterations; i++) {
        const start = performance.now();
        syntheticStudies.forEach(s => calcStudyStats(s));
        studyStatsTimes.push(performance.now() - start);
    }

    // Benchmark bivariate model
    const studyStats = syntheticStudies.map(s => ({
        ...calcStudyStats(s),
        name: s.name,
        quadas: s.quadas
    }));

    const modelTimes = [];
    for (let i = 0; i < iterations; i++) {
        const start = performance.now();
        bivariateModel(studyStats);
        modelTimes.push(performance.now() - start);
    }

    // Benchmark SROC
    const srocTimes = [];
    for (let i = 0; i < iterations; i++) {
        const start = performance.now();
        calcSROC(studyStats);
        srocTimes.push(performance.now() - start);
    }

    // Calculate averages
    const avg = arr => arr.reduce((a, b) => a + b, 0) / arr.length;
    const min = arr => Math.min(...arr);
    const max = arr => Math.max(...arr);

    console.log('📊 Benchmark Results:');
    console.log('─'.repeat(60));
    console.log(`Study Stats (${numStudies} studies):`);
    console.log(`  avg: ${avg(studyStatsTimes).toFixed(2)}ms, min: ${min(studyStatsTimes).toFixed(2)}ms, max: ${max(studyStatsTimes).toFixed(2)}ms`);
    console.log(`Bivariate Model:`);
    console.log(`  avg: ${avg(modelTimes).toFixed(2)}ms, min: ${min(modelTimes).toFixed(2)}ms, max: ${max(modelTimes).toFixed(2)}ms`);
    console.log(`SROC Curve:`);
    console.log(`  avg: ${avg(srocTimes).toFixed(2)}ms, min: ${min(srocTimes).toFixed(2)}ms, max: ${max(srocTimes).toFixed(2)}ms`);
    console.log('─'.repeat(60));
    console.log(`Total avg per full analysis: ${(avg(studyStatsTimes) + avg(modelTimes) + avg(srocTimes)).toFixed(2)}ms`);

    return {
        studyStats: { avg: avg(studyStatsTimes), min: min(studyStatsTimes), max: max(studyStatsTimes) },
        bivariate: { avg: avg(modelTimes), min: min(modelTimes), max: max(modelTimes) },
        sroc: { avg: avg(srocTimes), min: min(srocTimes), max: max(srocTimes) }
    };
}

