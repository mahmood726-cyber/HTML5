function updateQUADAS(studyId, domain, value) {
    const study = studies.find(s => s.id === studyId);
    if (study) {
        study.quadas[domain] = value;
        renderQUADASGrid();
        plotQUADASSummary();
    }
}

function getOverallRoB(q) {
    const values = [q.patient, q.index, q.reference, q.flow];
    if (values.includes('high')) return 'high';
    if (values.includes('some')) return 'some';
    if (values.includes('unclear')) return 'unclear';
    return 'low';
}

