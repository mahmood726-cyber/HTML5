// ========================
// STATISTICAL FUNCTIONS
// ========================

/**
 * Logit (log-odds) transformation with bounds protection
 * @param {number} p - Probability value (0-1)
 * @returns {number} Log-odds value
 */
function logit(p) {
    p = Math.max(STAT_CONSTANTS.LOGIT_BOUND_LOW, Math.min(STAT_CONSTANTS.LOGIT_BOUND_HIGH, p));
    return Math.log(p / (1 - p));
}

/**
 * Inverse logit (expit) transformation
 * @param {number} x - Log-odds value
 * @returns {number} Probability value (0-1)
 */
function invLogit(x) {
    // Protect against overflow
    if (x > 700) return 1;
    if (x < -700) return 0;
    return 1 / (1 + Math.exp(-x));
}

/**
 * Wilson score confidence interval for a single proportion
 * More accurate than normal approximation, especially for extreme proportions
 * @param {number} x - Number of successes
 * @param {number} n - Total sample size
 * @param {number} [z=1.96] - Z-score for confidence level (default 95%)
 * @returns {{lower: number, upper: number}} Confidence interval bounds
 */
function wilsonCI(x, n, z = STAT_CONSTANTS.Z_95) {
    if (n === 0) return { lower: 0, upper: 1 };
    const p = x / n;
    const denom = 1 + z * z / n;
    const center = p + z * z / (2 * n);
    const margin = z * Math.sqrt(Math.max(0, (p * (1 - p) + z * z / (4 * n)) / n));
    return {
        lower: Math.max(0, (center - margin) / denom),
        upper: Math.min(1, (center + margin) / denom)
    };
}

/**
 * Safe square root that handles floating-point edge cases
 * @param {number} x - Value to take square root of
 * @returns {number} Square root, or 0 if x is negative due to floating-point errors
 */
function safeSqrt(x) {
    return Math.sqrt(Math.max(0, x));
}

/**
 * Calculate study-level statistics including transformations and variances
 * @param {Object} study - Study object with tp, fp, fn, tn values
 * @returns {Object} Computed statistics for the study
 */
function calcStudyStats(study) {
    const tp = study.tp, fp = study.fp, fn = study.fn, tn = study.tn;
    const diseased = tp + fn;
    const healthy = fp + tn;
    const total = diseased + healthy;

    const sens = diseased > 0 ? tp / diseased : 0;
    const spec = healthy > 0 ? tn / healthy : 0;

    // Add continuity correction for zero cells
    const cc = STAT_CONSTANTS.CONTINUITY_CORRECTION;
    const tpC = tp + cc, fpC = fp + cc, fnC = fn + cc, tnC = tn + cc;
    const diseasedC = tpC + fnC, healthyC = fpC + tnC;

    const sensLogit = logit(tpC / diseasedC);
    const specLogit = logit(tnC / healthyC);

    // Variance of logit-transformed proportions
    const varSensLogit = 1 / tpC + 1 / fnC;
    const varSpecLogit = 1 / tnC + 1 / fpC;

    // DOR with continuity correction
    const dor = (tpC * tnC) / (fpC * fnC);
    const logDOR = Math.log(dor);
    const varLogDOR = 1/tpC + 1/fpC + 1/fnC + 1/tnC;

    // Wilson CIs
    const sensCI = wilsonCI(tp, diseased);
    const specCI = wilsonCI(tn, healthy);

    return {
        sens, spec, sensCI, specCI,
        sensLogit, specLogit, varSensLogit, varSpecLogit,
        dor, logDOR, varLogDOR,
        diseased, healthy, total,
        tp, fp, fn, tn,
        name: study.name
    };
}

/**
 * DerSimonian-Laird random effects meta-analysis for univariate outcome
 * @param {number[]} values - Effect estimates from each study
 * @param {number[]} variances - Within-study variances for each estimate
 * @param {number} [zScore=1.96] - Z-score for confidence interval
 * @returns {Object|null} Meta-analysis results or null if no data
 */
function univariateRE(values, variances, zScore = STAT_CONSTANTS.Z_95) {
    const k = values.length;
    if (k === 0) return null;

    // Fixed effect weights and estimate
    const weights = variances.map(v => v > 0 ? 1 / v : 0);
    const sumW = weights.reduce((a, b) => a + b, 0);
    if (sumW === 0) return null;

    const fixedEst = weights.reduce((sum, w, i) => sum + w * values[i], 0) / sumW;

    // Q statistic for heterogeneity
    const Q = weights.reduce((sum, w, i) => sum + w * Math.pow(values[i] - fixedEst, 2), 0);

    // DerSimonian-Laird tau-squared estimation
    const sumW2 = weights.reduce((a, b) => a + b * b, 0);
    const C = sumW - sumW2 / sumW;
    let tau2 = C > 0 ? Math.max(0, (Q - (k - 1)) / C) : 0;

    // Random effects weights and estimate
    const reWeights = variances.map(v => 1 / (v + tau2));
    const sumREW = reWeights.reduce((a, b) => a + b, 0);
    const reEst = reWeights.reduce((sum, w, i) => sum + w * values[i], 0) / sumREW;
    const reVar = 1 / sumREW;
    const reSE = safeSqrt(reVar);

    // I-squared: proportion of variance due to heterogeneity
    const I2 = k > 1 && Q > 0 ? Math.max(0, (Q - (k - 1)) / Q * 100) : 0;

    // p-value for Q statistic (chi-squared with k-1 df)
    const df = k - 1;
    const pQ = k > 1 ? 1 - chiSquareCDF(Q, df) : 1;

    // I² confidence interval using test-based method (Higgins & Thompson 2002)
    // CI based on non-central chi-squared distribution approximation
    let I2Lower = 0, I2Upper = 0;
    if (k > 2 && Q > 0) {
        // Use the approximation: SE(H²) ≈ H × sqrt(2×df) / sqrt(Q)
        // where H² = Q/df, then transform to I²
        const seLogH = safeSqrt(2 / df) * (1 - 1 / (3 * (df - 1)));
        const H2 = Q / df;
        const H = safeSqrt(H2);

        // CI for H, then transform to I²
        const Hlower = Math.max(1, Math.exp(Math.log(Math.max(1, H)) - zScore * seLogH));
        const Hupper = Math.exp(Math.log(Math.max(1, H)) + zScore * seLogH);

        // Transform H² to I²: I² = (H² - 1) / H² × 100
        I2Lower = Math.max(0, (Hlower * Hlower - 1) / (Hlower * Hlower) * 100);
        I2Upper = Math.min(100, (Hupper * Hupper - 1) / (Hupper * Hupper) * 100);

        // Ensure sensible bounds
        if (I2 === 0) {
            I2Lower = 0;
            I2Upper = Math.min(100, I2Upper);
        }
    }

    // Tau² confidence interval using Q-profile method (Viechtbauer 2007)
    // Based on the relationship: tau² = (Q - df) / C
    let tau2Lower = 0, tau2Upper = 0;
    if (k > 2 && C > 0) {
        // Use chi-squared quantiles for Q to derive tau² CI
        // Q ~ chi²(df) under null, but Q - df*tau² follows non-central chi²
        // Approximate CI using: tau² = max(0, (Q* - df) / C) where Q* are adjusted quantiles

        // For 95% CI, use Q boundaries from chi-squared distribution
        // Lower bound: tau² when Q = Q_observed at upper percentile
        // Upper bound: tau² when Q = Q_observed at lower percentile

        // Simplified approach: SE(tau²) ≈ tau² × sqrt(2/k) for DL estimator
        const seTau2 = tau2 > 0 ? tau2 * safeSqrt(2 / Math.max(1, k - 1)) : 0;

        // More accurate: use the variance of DL estimator
        // Var(tau²_DL) ≈ 2 / C² × (k-1 + 2*(Q-k+1)*tau² / typical_var + (Q-k+1)²*tau²² / typical_var²)
        // Simplified approximation based on asymptotic variance
        const typicalVar = sumW > 0 ? k / sumW : 1;
        const varTau2 = k > 1 ? (2 * (k - 1) + 4 * (Q - k + 1) / typicalVar) / (C * C) : 0;
        const seTau2Refined = safeSqrt(Math.max(0, varTau2));

        // Use larger of the two SE estimates for conservatism
        const seTau2Final = Math.max(seTau2, seTau2Refined);

        // Apply Wald-type CI with log transformation for non-negativity
        if (tau2 > 0) {
            const logTau2 = Math.log(tau2);
            const seLogTau2 = seTau2Final / tau2;
            tau2Lower = Math.max(0, Math.exp(logTau2 - zScore * seLogTau2));
            tau2Upper = Math.exp(logTau2 + zScore * seLogTau2);
        } else {
            // When tau² = 0, use one-sided CI
            tau2Lower = 0;
            tau2Upper = Math.max(0, seTau2Final * zScore * zScore);
        }
    }

    // Tau (standard deviation) for interpretability
    const tau = safeSqrt(tau2);
    const tauCI = [safeSqrt(tau2Lower), safeSqrt(tau2Upper)];

    return {
        estimate: reEst,
        se: reSE,
        ci: [reEst - zScore * reSE, reEst + zScore * reSE],
        tau2,
        tau2CI: [tau2Lower, tau2Upper],
        tau,
        tauCI,
        Q,
        pQ,
        I2,
        I2CI: [I2Lower, I2Upper],  // I² confidence interval
        k
    };
}

/**
 * Chi-squared cumulative distribution function approximation
 * @param {number} x - Chi-squared value
 * @param {number} df - Degrees of freedom
 * @returns {number} Cumulative probability
 */
function chiSquareCDF(x, df) {
    if (x <= 0 || df <= 0) return 0;
    // Use incomplete gamma function approximation
    return gammaCDF(x / 2, df / 2);
}

/**
 * Gamma CDF using series expansion (for chi-squared calculation)
 * @param {number} x - Value
 * @param {number} a - Shape parameter
 * @returns {number} Cumulative probability
 */
function gammaCDF(x, a) {
    if (x <= 0) return 0;
    if (a <= 0) return 1;

    // Series expansion for lower incomplete gamma
    let sum = 0;
    let term = 1 / a;
    sum = term;

    for (let n = 1; n < 200; n++) {
        term *= x / (a + n);
        sum += term;
        if (Math.abs(term) < 1e-12) break;
    }

    const logGamma = gammaLn(a);
    return Math.min(1, sum * Math.exp(-x + a * Math.log(x) - logGamma));
}

/**
 * Log gamma function approximation (Stirling's approximation with correction)
 * @param {number} x - Input value
 * @returns {number} ln(Gamma(x))
 */
function gammaLn(x) {
    if (x <= 0) return Infinity;
    const c = [76.18009172947146, -86.50532032941677, 24.01409824083091,
               -1.231739572450155, 0.1208650973866179e-2, -0.5395239384953e-5];
    let y = x;
    let tmp = x + 5.5;
    tmp -= (x + 0.5) * Math.log(tmp);
    let ser = 1.000000000190015;
    for (let j = 0; j < 6; j++) {
        ser += c[j] / ++y;
    }
    return -tmp + Math.log(2.5066282746310005 * ser / x);
}

// ========================
// MATRIX OPERATIONS FOR BIVARIATE REML
// ========================

/**
 * 2x2 Matrix operations for bivariate model
 */
const Matrix2x2 = {
    // Create 2x2 matrix
    create(a, b, c, d) {
        return [[a, b], [c, d]];
    },

    // Matrix addition
    add(A, B) {
        return [
            [A[0][0] + B[0][0], A[0][1] + B[0][1]],
            [A[1][0] + B[1][0], A[1][1] + B[1][1]]
        ];
    },

    // Matrix inverse
    inverse(A) {
        const det = A[0][0] * A[1][1] - A[0][1] * A[1][0];
        if (Math.abs(det) < 1e-15) return null;
        return [
            [A[1][1] / det, -A[0][1] / det],
            [-A[1][0] / det, A[0][0] / det]
        ];
    },

    // Determinant
    det(A) {
        return A[0][0] * A[1][1] - A[0][1] * A[1][0];
    },

    // Matrix-vector multiply
    mulVec(A, v) {
        return [
            A[0][0] * v[0] + A[0][1] * v[1],
            A[1][0] * v[0] + A[1][1] * v[1]
        ];
    },

    // Scalar multiply
    scale(A, s) {
        return [
            [A[0][0] * s, A[0][1] * s],
            [A[1][0] * s, A[1][1] * s]
        ];
    },

    // Trace
    trace(A) {
        return A[0][0] + A[1][1];
    }
};

/**
 * True Bivariate REML estimation using iterative algorithm
 * Estimates the between-study variance-covariance matrix (Sigma)
 * @param {number[]} y1 - First outcome (logit sens)
 * @param {number[]} y2 - Second outcome (logit spec)
 * @param {number[]} v1 - Within-study variance for y1
 * @param {number[]} v2 - Within-study variance for y2
 * @param {number} maxIter - Maximum iterations
 * @param {number} tol - Convergence tolerance
 * @returns {Object} REML estimates
 */
function bivariateREML(y1, y2, v1, v2, maxIter = 100, tol = 1e-6) {
    const k = y1.length;
    if (k < 3) return null;

    // Initialize between-study variance-covariance matrix (Sigma)
    // Using method of moments for starting values
    const mean1 = y1.reduce((a, b) => a + b, 0) / k;
    const mean2 = y2.reduce((a, b) => a + b, 0) / k;

    let var1 = 0, var2 = 0, cov12 = 0;
    for (let i = 0; i < k; i++) {
        var1 += (y1[i] - mean1) ** 2;
        var2 += (y2[i] - mean2) ** 2;
        cov12 += (y1[i] - mean1) * (y2[i] - mean2);
    }
    var1 = Math.max(0.01, var1 / (k - 1) - v1.reduce((a, b) => a + b, 0) / k);
    var2 = Math.max(0.01, var2 / (k - 1) - v2.reduce((a, b) => a + b, 0) / k);
    cov12 = cov12 / (k - 1);

    // Constrain correlation to [-0.95, 0.95]
    const maxCov = 0.95 * Math.sqrt(var1 * var2);
    cov12 = Math.max(-maxCov, Math.min(maxCov, cov12));

    // Between-study covariance matrix (Sigma)
    let Sigma = Matrix2x2.create(var1, cov12, cov12, var2);

    // Convergence tracking
    let converged = false;
    let iterations = 0;
    let finalDiff = Infinity;

    // Iterative REML estimation (Fisher scoring)
    for (let iter = 0; iter < maxIter; iter++) {
        iterations = iter + 1;
        // Compute weights and weighted estimates
        let sumW = Matrix2x2.create(0, 0, 0, 0);
        let sumWy = [0, 0];

        for (let i = 0; i < k; i++) {
            // Total variance for study i: Vi = Si + Sigma
            // Si = within-study variance (diagonal, assuming independence)
            const Si = Matrix2x2.create(v1[i], 0, 0, v2[i]);
            const Vi = Matrix2x2.add(Si, Sigma);
            const Wi = Matrix2x2.inverse(Vi);

            if (!Wi) continue;

            sumW = Matrix2x2.add(sumW, Wi);
            const wy = Matrix2x2.mulVec(Wi, [y1[i], y2[i]]);
            sumWy[0] += wy[0];
            sumWy[1] += wy[1];
        }

        // Weighted mean estimates
        const sumWinv = Matrix2x2.inverse(sumW);
        if (!sumWinv) break;

        const mu = Matrix2x2.mulVec(sumWinv, sumWy);

        // Update Sigma using method of moments (simplified)
        let newVar1 = 0, newVar2 = 0, newCov = 0;
        let totalW1 = 0, totalW2 = 0;

        for (let i = 0; i < k; i++) {
            const r1 = y1[i] - mu[0];
            const r2 = y2[i] - mu[1];

            const Si = Matrix2x2.create(v1[i], 0, 0, v2[i]);
            const Vi = Matrix2x2.add(Si, Sigma);
            const Wi = Matrix2x2.inverse(Vi);
            if (!Wi) continue;

            // Weighted residual contribution to variance
            const w1 = 1 / (v1[i] + Sigma[0][0]);
            const w2 = 1 / (v2[i] + Sigma[1][1]);

            newVar1 += w1 * (r1 * r1 - v1[i]);
            newVar2 += w2 * (r2 * r2 - v2[i]);
            newCov += Math.sqrt(w1 * w2) * r1 * r2;

            totalW1 += w1;
            totalW2 += w2;
        }

        // Update estimates
        const newSigma11 = Math.max(0.001, newVar1 / Math.max(1, totalW1 - 1));
        const newSigma22 = Math.max(0.001, newVar2 / Math.max(1, totalW2 - 1));
        const maxCovNew = 0.95 * Math.sqrt(newSigma11 * newSigma22);
        const newSigma12 = Math.max(-maxCovNew, Math.min(maxCovNew,
            newCov / Math.max(1, Math.sqrt(totalW1 * totalW2) - 1)));

        const newSigma = Matrix2x2.create(newSigma11, newSigma12, newSigma12, newSigma22);

        // Check convergence
        const diff = Math.abs(newSigma[0][0] - Sigma[0][0]) +
                    Math.abs(newSigma[1][1] - Sigma[1][1]) +
                    Math.abs(newSigma[0][1] - Sigma[0][1]);

        finalDiff = diff;
        Sigma = newSigma;

        if (diff < tol) {
            converged = true;
            break;
        }
    }

    // Final weighted estimates with converged Sigma
    let sumW = Matrix2x2.create(0, 0, 0, 0);
    let sumWy = [0, 0];

    for (let i = 0; i < k; i++) {
        const Si = Matrix2x2.create(v1[i], 0, 0, v2[i]);
        const Vi = Matrix2x2.add(Si, Sigma);
        const Wi = Matrix2x2.inverse(Vi);
        if (!Wi) continue;

        sumW = Matrix2x2.add(sumW, Wi);
        const wy = Matrix2x2.mulVec(Wi, [y1[i], y2[i]]);
        sumWy[0] += wy[0];
        sumWy[1] += wy[1];
    }

    const sumWinv = Matrix2x2.inverse(sumW);
    if (!sumWinv) return null;

    const mu = Matrix2x2.mulVec(sumWinv, sumWy);

    // Standard errors from inverse of sum of weights
    const se1 = safeSqrt(sumWinv[0][0]);
    const se2 = safeSqrt(sumWinv[1][1]);

    // Correlation from Sigma
    const rho = Sigma[0][1] / safeSqrt(Sigma[0][0] * Sigma[1][1]);

    return {
        mu: mu,                    // [mu1, mu2] - pooled estimates on logit scale
        se: [se1, se2],           // Standard errors
        Sigma: Sigma,              // Between-study covariance matrix
        covMu: sumWinv,           // Covariance matrix of mu estimates
        tau2: [Sigma[0][0], Sigma[1][1]],  // Between-study variances
        rho: rho,                  // Between-study correlation
        k: k,
        // Convergence diagnostics
        convergence: {
            converged: converged,
            iterations: iterations,
            finalDiff: finalDiff,
            tolerance: tol,
            maxIterations: maxIter
        }
    };
}

/**
 * Calculate confidence/prediction ellipse points for SROC plot
 * @param {number} mu1 - Mean of first variable (logit sens)
 * @param {number} mu2 - Mean of second variable (logit FPR)
 * @param {Array} covMatrix - 2x2 covariance matrix
 * @param {number} level - Confidence level (e.g., 0.95)
 * @param {number} nPoints - Number of points on ellipse
 * @returns {Array} Array of {sens, fpr} points
 */
function calculateEllipse(mu1, mu2, covMatrix, level = 0.95, nPoints = 100) {
    // Chi-squared critical value for 2 df
    const chiSq = -2 * Math.log(1 - level);

    // Eigenvalue decomposition for ellipse orientation
    const a = covMatrix[0][0];
    const b = covMatrix[0][1];
    const c = covMatrix[1][1];

    const trace = a + c;
    const det = a * c - b * b;

    if (det <= 0) return [];

    const lambda1 = (trace + safeSqrt(trace * trace - 4 * det)) / 2;
    const lambda2 = (trace - safeSqrt(trace * trace - 4 * det)) / 2;

    // Semi-axes
    const axis1 = safeSqrt(chiSq * Math.max(0.001, lambda1));
    const axis2 = safeSqrt(chiSq * Math.max(0.001, lambda2));

    // Rotation angle
    const theta = b !== 0 ? Math.atan2(lambda1 - a, b) : 0;

    const points = [];
    for (let i = 0; i < nPoints; i++) {
        const t = (2 * Math.PI * i) / nPoints;

        // Parametric ellipse
        const x = axis1 * Math.cos(t);
        const y = axis2 * Math.sin(t);

        // Rotate
        const xRot = x * Math.cos(theta) - y * Math.sin(theta);
        const yRot = x * Math.sin(theta) + y * Math.cos(theta);

        // Translate to center
        const logitSens = mu1 + xRot;
        const logitFpr = mu2 + yRot;

        // Transform to probability scale
        const sens = invLogit(logitSens);
        const fpr = invLogit(logitFpr);

        if (sens > 0 && sens < 1 && fpr > 0 && fpr < 1) {
            points.push({ sens, fpr });
        }
    }

    return points;
}

/**
 * Bivariate random effects model for DTA meta-analysis (Reitsma approach)
 * Now uses TRUE bivariate REML estimation
 * @param {Object[]} studyStats - Array of study statistics from calcStudyStats
 * @param {number} [zScore=1.96] - Z-score for confidence intervals
 * @returns {Object|null} Model results or null if insufficient data
 */
function bivariateModel(studyStats, zScore = STAT_CONSTANTS.Z_95) {
    const k = studyStats.length;
    if (k < STAT_CONSTANTS.MIN_STUDIES_BIVARIATE) return null;

    // Extract logit-transformed values
    const sensLogits = studyStats.map(s => s.sensLogit);
    const specLogits = studyStats.map(s => s.specLogit);
    const varSens = studyStats.map(s => s.varSensLogit);
    const varSpec = studyStats.map(s => s.varSpecLogit);

    // For bivariate model, we model (logit_sens, logit_fpr) where fpr = 1 - spec
    // logit(fpr) = logit(1-spec) = -logit(spec)
    const fprLogits = specLogits.map(s => -s);

    // Try true bivariate REML first
    const reml = bivariateREML(sensLogits, fprLogits, varSens, varSpec);

    // Also compute univariate for heterogeneity stats (I², Q)
    const sensRE = univariateRE(sensLogits, varSens, zScore);
    const specRE = univariateRE(specLogits, varSpec, zScore);

    if (!reml && !sensRE) return null;

    // Use REML results if available, otherwise fall back to univariate
    let pooledSensLogit, pooledFprLogit, seSens, seFpr, tau2Sens, tau2Fpr, correlation;
    let covMatrix = null;
    let predCovMatrix = null;

    if (reml) {
        pooledSensLogit = reml.mu[0];
        pooledFprLogit = reml.mu[1];
        seSens = reml.se[0];
        seFpr = reml.se[1];
        tau2Sens = reml.tau2[0];
        tau2Fpr = reml.tau2[1];
        correlation = reml.rho;
        covMatrix = reml.covMu;  // Covariance matrix of estimates

        // Prediction covariance (adds between-study variance)
        predCovMatrix = Matrix2x2.add(covMatrix, reml.Sigma);
    } else {
        // Fallback to univariate
        pooledSensLogit = sensRE.estimate;
        pooledFprLogit = -specRE.estimate;  // logit(fpr) = -logit(spec)
        seSens = sensRE.se;
        seFpr = specRE.se;
        tau2Sens = sensRE.tau2;
        tau2Fpr = specRE.tau2;
        correlation = null;
    }

    // Transform back to probability scale
    const pooledSens = invLogit(pooledSensLogit);
    const pooledSpec = invLogit(-pooledFprLogit);  // spec = 1 - fpr = invLogit(-logit_fpr)

    // CI on probability scale
    const sensLower = invLogit(pooledSensLogit - zScore * seSens);
    const sensUpper = invLogit(pooledSensLogit + zScore * seSens);
    const specLower = invLogit(-pooledFprLogit - zScore * seFpr);
    const specUpper = invLogit(-pooledFprLogit + zScore * seFpr);

    // Prediction intervals: incorporate between-study variance (tau²)
    const sensPredSE = safeSqrt(seSens * seSens + tau2Sens);
    const specPredSE = safeSqrt(seFpr * seFpr + tau2Fpr);
    const sensPredLower = invLogit(pooledSensLogit - zScore * sensPredSE);
    const sensPredUpper = invLogit(pooledSensLogit + zScore * sensPredSE);
    const specPredLower = invLogit(-pooledFprLogit - zScore * specPredSE);
    const specPredUpper = invLogit(-pooledFprLogit + zScore * specPredSE);

    // Calculate ellipse points for SROC plot
    let confEllipse = null, predEllipse = null;
    if (covMatrix) {
        confEllipse = calculateEllipse(pooledSensLogit, pooledFprLogit, covMatrix, currentCILevel);
        if (predCovMatrix) {
            predEllipse = calculateEllipse(pooledSensLogit, pooledFprLogit, predCovMatrix, currentCILevel);
        }
    }

    // Likelihood ratios with protection against division by zero
    const oneMinusSpec = Math.max(STAT_CONSTANTS.LOGIT_BOUND_LOW, 1 - pooledSpec);
    const oneMinusSens = Math.max(STAT_CONSTANTS.LOGIT_BOUND_LOW, 1 - pooledSens);
    const safeSpec = Math.max(STAT_CONSTANTS.LOGIT_BOUND_LOW, pooledSpec);
    const safeSens = Math.max(STAT_CONSTANTS.LOGIT_BOUND_LOW, pooledSens);

    const PLR = safeSens / oneMinusSpec;
    const NLR = oneMinusSens / safeSpec;
    const DOR = PLR / NLR;

    // Proper log-scale CIs for likelihood ratios using delta method
    const logPLR = Math.log(PLR);
    const logNLR = Math.log(NLR);
    const varLogSens = Math.pow(seSens / safeSens, 2);
    const varLogOneMinusSpec = Math.pow(seFpr / oneMinusSpec, 2);
    const logPLRSE = safeSqrt(varLogSens + varLogOneMinusSpec);
    const varLogOneMinusSens = Math.pow(seSens / oneMinusSens, 2);
    const varLogSpec = Math.pow(seFpr / safeSpec, 2);
    const logNLRSE = safeSqrt(varLogOneMinusSens + varLogSpec);
    const logDOR = Math.log(DOR);
    const logDORSE = safeSqrt(varLogSens + varLogOneMinusSpec + varLogOneMinusSens + varLogSpec);

    return {
        sensitivity: {
            estimate: pooledSens,
            ci: [sensLower, sensUpper],
            pi: [sensPredLower, sensPredUpper],
            se: seSens,
            logit: pooledSensLogit,
            tau2: tau2Sens,
            I2: sensRE ? sensRE.I2 : 0,
            I2CI: sensRE ? sensRE.I2CI : [0, 0],
            Q: sensRE ? sensRE.Q : 0,
            pQ: sensRE ? sensRE.pQ : 1
        },
        specificity: {
            estimate: pooledSpec,
            ci: [specLower, specUpper],
            pi: [specPredLower, specPredUpper],
            se: seFpr,
            logit: -pooledFprLogit,
            tau2: tau2Fpr,
            I2: specRE ? specRE.I2 : 0,
            I2CI: specRE ? specRE.I2CI : [0, 0],
            Q: specRE ? specRE.Q : 0,
            pQ: specRE ? specRE.pQ : 1
        },
        PLR: {
            estimate: PLR,
            ci: [Math.exp(logPLR - zScore * logPLRSE),
                 Math.exp(logPLR + zScore * logPLRSE)]
        },
        NLR: {
            estimate: NLR,
            ci: [Math.exp(logNLR - zScore * logNLRSE),
                 Math.exp(logNLR + zScore * logNLRSE)]
        },
        DOR: {
            estimate: DOR,
            ci: [Math.exp(logDOR - zScore * logDORSE),
                 Math.exp(logDOR + zScore * logDORSE)]
        },
        correlation,
        confEllipse,    // Confidence ellipse points for SROC
        predEllipse,    // Prediction ellipse points for SROC
        covMatrix,      // Covariance matrix of estimates
        convergence: reml ? reml.convergence : null,  // REML convergence diagnostics
        k,
        modelType: 'bivariate',
        ciLevel: currentCILevel
    };
}

/**
 * HSROC (Hierarchical Summary ROC) model implementation
 * Rutter-Gatsonis parameterization focusing on accuracy and threshold
 * @param {Object[]} studyStats - Array of study statistics from calcStudyStats
 * @param {number} [zScore=1.96] - Z-score for confidence intervals
 * @returns {Object|null} Model results or null if insufficient data
 */
function hsrocModel(studyStats, zScore = STAT_CONSTANTS.Z_95) {
    const k = studyStats.length;
    if (k < STAT_CONSTANTS.MIN_STUDIES_BIVARIATE) return null;

    // HSROC uses D (accuracy proxy) and S (threshold proxy) parameterization
    // D = logit(sens) + logit(spec) ≈ log(DOR) - measures overall accuracy
    // S = logit(sens) - logit(spec) - measures threshold/positivity criterion
    //
    // Key assumption: Within-study, sens and spec are independent because they
    // are measured on different subjects (diseased vs non-diseased).
    // Therefore: Var(D) = Var(S) = Var(sensLogit) + Var(specLogit)

    const D = studyStats.map(s => s.sensLogit + s.specLogit);
    const S = studyStats.map(s => s.sensLogit - s.specLogit);

    // Within-study variances (Cov = 0 due to independence of diseased/healthy groups)
    const varD = studyStats.map(s => s.varSensLogit + s.varSpecLogit);
    const varS = studyStats.map(s => s.varSensLogit + s.varSpecLogit);

    // Meta-analyze D (overall accuracy) and S (threshold)
    const dRE = univariateRE(D, varD);
    const sRE = univariateRE(S, varS);

    if (!dRE || !sRE) return null;

    // HSROC parameters
    const Lambda = dRE.estimate;  // Overall log-DOR (accuracy parameter)
    const Theta = sRE.estimate;   // Threshold parameter (positivity criterion)

    // Beta: asymmetry parameter (slope of SROC curve)
    // Estimated via weighted regression of D on S
    const meanD = D.reduce((a, b) => a + b, 0) / k;
    const meanS = S.reduce((a, b) => a + b, 0) / k;

    // Use inverse-variance weights for regression
    const weights = varD.map(v => v > 0 ? 1 / v : 0);
    const sumW = weights.reduce((a, b) => a + b, 0);

    let sumWSD = 0, sumWSS = 0;
    for (let i = 0; i < k; i++) {
        const w = weights[i];
        sumWSD += w * (S[i] - meanS) * (D[i] - meanD);
        sumWSS += w * (S[i] - meanS) * (S[i] - meanS);
    }

    const beta = sumWSS > 0 ? sumWSD / sumWSS : 0;
    const seBeta = sumWSS > 0 ? safeSqrt(1 / sumWSS) : 0;

    // Estimate covariance between Lambda and Theta estimates
    // Cov(Lambda, Theta) ≈ Cov(mean(D), mean(S)) estimated from data
    let sumDS = 0;
    for (let i = 0; i < k; i++) {
        sumDS += (D[i] - meanD) * (S[i] - meanS);
    }
    const covDS = sumDS / (k - 1);
    const covLambdaTheta = covDS / k;  // Covariance of means

    // Convert back to sensitivity/specificity at the summary threshold
    // At threshold Theta: sensLogit = (Lambda + Theta)/2, specLogit = (Lambda - Theta)/2
    const summaryLogitSens = (Lambda + Theta) / 2;
    const summaryLogitSpec = (Lambda - Theta) / 2;

    const pooledSens = invLogit(summaryLogitSens);
    const pooledSpec = invLogit(summaryLogitSpec);

    // Variances using delta method with covariance term
    // Var((Lambda + Theta)/2) = (Var(Lambda) + Var(Theta) + 2*Cov(Lambda,Theta)) / 4
    // Var((Lambda - Theta)/2) = (Var(Lambda) + Var(Theta) - 2*Cov(Lambda,Theta)) / 4
    const varLambda = dRE.se * dRE.se;
    const varTheta = sRE.se * sRE.se;
    const varLogitSens = (varLambda + varTheta + 2 * covLambdaTheta) / 4;
    const varLogitSpec = (varLambda + varTheta - 2 * covLambdaTheta) / 4;

    const seLogitSens = safeSqrt(varLogitSens);
    const seLogitSpec = safeSqrt(varLogitSpec);

    // CIs on probability scale
    const sensLower = invLogit(summaryLogitSens - zScore * seLogitSens);
    const sensUpper = invLogit(summaryLogitSens + zScore * seLogitSens);
    const specLower = invLogit(summaryLogitSpec - zScore * seLogitSpec);
    const specUpper = invLogit(summaryLogitSpec + zScore * seLogitSpec);

    // Likelihood ratios
    const oneMinusSpec = Math.max(STAT_CONSTANTS.LOGIT_BOUND_LOW, 1 - pooledSpec);
    const oneMinusSens = Math.max(STAT_CONSTANTS.LOGIT_BOUND_LOW, 1 - pooledSens);
    const safeSpec = Math.max(STAT_CONSTANTS.LOGIT_BOUND_LOW, pooledSpec);
    const safeSens = Math.max(STAT_CONSTANTS.LOGIT_BOUND_LOW, pooledSens);

    const PLR = safeSens / oneMinusSpec;
    const NLR = oneMinusSens / safeSpec;
    const DOR = Math.exp(Lambda);

    // CIs for likelihood ratios
    const logPLR = Math.log(PLR);
    const logNLR = Math.log(NLR);
    const logPLRSE = safeSqrt(varLogitSens / (safeSens * safeSens) + varLogitSpec / (oneMinusSpec * oneMinusSpec));
    const logNLRSE = safeSqrt(varLogitSens / (oneMinusSens * oneMinusSens) + varLogitSpec / (safeSpec * safeSpec));

    // I² for overall accuracy (D)
    const I2Accuracy = dRE.I2;

    // Between-study variance components
    const tau2Theta = sRE.tau2;  // Threshold variation
    const tau2Lambda = dRE.tau2; // Accuracy variation

    // Prediction intervals: incorporate between-study variance
    // For HSROC: tau² for sens/spec derived from tau²Lambda and tau²Theta
    const tau2Sens = (tau2Lambda + tau2Theta + 2 * covLambdaTheta) / 4;
    const tau2Spec = (tau2Lambda + tau2Theta - 2 * covLambdaTheta) / 4;
    const sensPredSE = safeSqrt(varLogitSens + tau2Sens);
    const specPredSE = safeSqrt(varLogitSpec + tau2Spec);
    const sensPredLower = invLogit(summaryLogitSens - zScore * sensPredSE);
    const sensPredUpper = invLogit(summaryLogitSens + zScore * sensPredSE);
    const specPredLower = invLogit(summaryLogitSpec - zScore * specPredSE);
    const specPredUpper = invLogit(summaryLogitSpec + zScore * specPredSE);

    return {
        sensitivity: {
            estimate: pooledSens,
            ci: [sensLower, sensUpper],
            pi: [sensPredLower, sensPredUpper],  // Prediction interval
            se: seLogitSens,
            logit: summaryLogitSens,
            tau2: tau2Sens,
            I2: I2Accuracy
        },
        specificity: {
            estimate: pooledSpec,
            ci: [specLower, specUpper],
            pi: [specPredLower, specPredUpper],  // Prediction interval
            se: seLogitSpec,
            logit: summaryLogitSpec,
            tau2: tau2Spec,
            I2: I2Accuracy
        },
        PLR: {
            estimate: PLR,
            ci: [Math.exp(logPLR - zScore * logPLRSE),
                 Math.exp(logPLR + zScore * logPLRSE)]
        },
        NLR: {
            estimate: NLR,
            ci: [Math.exp(logNLR - zScore * logNLRSE),
                 Math.exp(logNLR + zScore * logNLRSE)]
        },
        DOR: {
            estimate: DOR,
            ci: [Math.exp(Lambda - zScore * dRE.se),
                 Math.exp(Lambda + zScore * dRE.se)]
        },
        // HSROC-specific parameters
        hsroc: {
            Lambda: Lambda,           // Overall accuracy (log-DOR)
            LambdaSE: dRE.se,
            Theta: Theta,             // Threshold parameter
            ThetaSE: sRE.se,
            beta: beta,               // Asymmetry parameter
            betaSE: seBeta,           // SE of asymmetry parameter
            betaCI: [beta - zScore * seBeta, beta + zScore * seBeta],
            tau2Lambda: tau2Lambda,   // Between-study variance in accuracy
            tau2Theta: tau2Theta      // Between-study variance in threshold
        },
        correlation: -beta / (1 + Math.abs(beta)), // Approximate correlation
        k,
        ciLevel: currentCILevel,
        modelType: 'hsroc'
    };
}

/**
 * Simple univariate random effects model for DTA
 * Analyzes sensitivity and specificity separately (ignores correlation)
 * Useful when bivariate model fails or for quick analysis
 * @param {Object[]} studyStats - Array of study statistics from calcStudyStats
 * @param {number} [zScore=1.96] - Z-score for confidence intervals
 * @returns {Object|null} Model results or null if insufficient data
 */
function univariateModel(studyStats, zScore = STAT_CONSTANTS.Z_95) {
    const k = studyStats.length;
    if (k < STAT_CONSTANTS.MIN_STUDIES_UNIVARIATE) return null;

    // Extract values
    const sensLogits = studyStats.map(s => s.sensLogit);
    const specLogits = studyStats.map(s => s.specLogit);
    const varSens = studyStats.map(s => s.varSensLogit);
    const varSpec = studyStats.map(s => s.varSpecLogit);

    // Separate univariate analyses with the configured Z-score
    const sensRE = univariateRE(sensLogits, varSens, zScore);
    const specRE = univariateRE(specLogits, varSpec, zScore);

    if (!sensRE || !specRE) return null;

    // Transform to probability scale
    const pooledSens = invLogit(sensRE.estimate);
    const pooledSpec = invLogit(specRE.estimate);

    const sensLower = invLogit(sensRE.ci[0]);
    const sensUpper = invLogit(sensRE.ci[1]);
    const specLower = invLogit(specRE.ci[0]);
    const specUpper = invLogit(specRE.ci[1]);

    // Likelihood ratios
    const oneMinusSpec = Math.max(STAT_CONSTANTS.LOGIT_BOUND_LOW, 1 - pooledSpec);
    const oneMinusSens = Math.max(STAT_CONSTANTS.LOGIT_BOUND_LOW, 1 - pooledSens);
    const safeSpec = Math.max(STAT_CONSTANTS.LOGIT_BOUND_LOW, pooledSpec);
    const safeSens = Math.max(STAT_CONSTANTS.LOGIT_BOUND_LOW, pooledSens);

    const PLR = safeSens / oneMinusSpec;
    const NLR = oneMinusSens / safeSpec;
    const DOR = PLR / NLR;

    // CIs for likelihood ratios (assuming independence)
    const logPLR = Math.log(PLR);
    const logNLR = Math.log(NLR);
    const logPLRSE = safeSqrt(Math.pow(sensRE.se / safeSens, 2) + Math.pow(specRE.se / oneMinusSpec, 2));
    const logNLRSE = safeSqrt(Math.pow(sensRE.se / oneMinusSens, 2) + Math.pow(specRE.se / safeSpec, 2));
    const logDOR = Math.log(DOR);
    const logDORSE = safeSqrt(logPLRSE * logPLRSE + logNLRSE * logNLRSE);

    // Prediction intervals: incorporate between-study variance (tau²)
    const sensPredSE = safeSqrt(sensRE.se * sensRE.se + sensRE.tau2);
    const specPredSE = safeSqrt(specRE.se * specRE.se + specRE.tau2);
    const sensPredLower = invLogit(sensRE.estimate - zScore * sensPredSE);
    const sensPredUpper = invLogit(sensRE.estimate + zScore * sensPredSE);
    const specPredLower = invLogit(specRE.estimate - zScore * specPredSE);
    const specPredUpper = invLogit(specRE.estimate + zScore * specPredSE);

    return {
        sensitivity: {
            estimate: pooledSens,
            ci: [sensLower, sensUpper],
            pi: [sensPredLower, sensPredUpper],  // Prediction interval
            se: sensRE.se,
            logit: sensRE.estimate,
            tau2: sensRE.tau2,
            I2: sensRE.I2,
            I2CI: sensRE.I2CI,  // I² confidence interval
            Q: sensRE.Q,
            pQ: sensRE.pQ
        },
        specificity: {
            estimate: pooledSpec,
            ci: [specLower, specUpper],
            pi: [specPredLower, specPredUpper],  // Prediction interval
            se: specRE.se,
            logit: specRE.estimate,
            tau2: specRE.tau2,
            I2: specRE.I2,
            I2CI: specRE.I2CI,  // I² confidence interval
            Q: specRE.Q,
            pQ: specRE.pQ
        },
        PLR: {
            estimate: PLR,
            ci: [Math.exp(logPLR - zScore * logPLRSE),
                 Math.exp(logPLR + zScore * logPLRSE)]
        },
        NLR: {
            estimate: NLR,
            ci: [Math.exp(logNLR - zScore * logNLRSE),
                 Math.exp(logNLR + zScore * logNLRSE)]
        },
        DOR: {
            estimate: DOR,
            ci: [Math.exp(logDOR - zScore * logDORSE),
                 Math.exp(logDOR + zScore * logDORSE)]
        },
        correlation: null, // Not estimated in univariate model
        k,
        modelType: 'univariate',
        ciLevel: currentCILevel,
        // Methodological warning: univariate ignores sens-spec correlation
        warning: 'Univariate model treats sensitivity and specificity independently. ' +
                 'This may underestimate uncertainty in likelihood ratios and DOR. ' +
                 'Consider bivariate or HSROC models for more accurate inference.'
    };
}

// ========================
// META-REGRESSION
// ========================

/**
 * Meta-regression for exploring sources of heterogeneity
 * Tests whether a covariate explains variation in sensitivity or specificity
 * @param {number[]} outcome - Outcome values (logit sens or logit spec)
 * @param {number[]} variance - Within-study variances
 * @param {number[]} covariate - Covariate values
 * @param {number} tau2 - Between-study variance from base model
 * @param {number} zScore - Z-score for CI
 * @returns {Object} Meta-regression results
 */
function metaRegression(outcome, variance, covariate, tau2, zScore = STAT_CONSTANTS.Z_95, useKnappHartung = true) {
    const n = outcome.length;
    if (n < 4) return null;  // Need at least 4 studies for regression

    // Weights incorporating between-study variance
    const weights = variance.map(v => 1 / (v + tau2));
    const sumW = weights.reduce((a, b) => a + b, 0);

    // Weighted means
    const meanY = weights.reduce((s, w, i) => s + w * outcome[i], 0) / sumW;
    const meanX = weights.reduce((s, w, i) => s + w * covariate[i], 0) / sumW;

    // Weighted regression coefficients
    let sumWXX = 0, sumWXY = 0;
    for (let i = 0; i < n; i++) {
        const dx = covariate[i] - meanX;
        sumWXX += weights[i] * dx * dx;
        sumWXY += weights[i] * dx * (outcome[i] - meanY);
    }

    if (sumWXX === 0) return null;

    const beta1 = sumWXY / sumWXX;  // Slope
    const beta0 = meanY - beta1 * meanX;  // Intercept

    // Residuals and residual heterogeneity (Q_residual)
    let qRes = 0;
    for (let i = 0; i < n; i++) {
        const predicted = beta0 + beta1 * covariate[i];
        const residual = outcome[i] - predicted;
        qRes += weights[i] * residual * residual;
    }

    // Base variance of slope (without Knapp-Hartung)
    const varBeta1Base = 1 / sumWXX;

    // Knapp-Hartung adjustment: inflate SE using residual heterogeneity
    // SE_KH = SE_base * sqrt(Q_res / (n-2))
    let seBeta1, tStat, pValue, criticalValue, method;
    const df = n - 2;

    if (useKnappHartung && df > 0) {
        // Knapp-Hartung inflation factor
        const khFactor = safeSqrt(Math.max(1, qRes / df));
        seBeta1 = safeSqrt(varBeta1Base) * khFactor;

        // Use t-distribution
        tStat = seBeta1 > 0 ? beta1 / seBeta1 : 0;

        // t-distribution critical value (approximation for 95% CI)
        // Using approximation: t_{0.975,df} ≈ 1.96 + 2.36/df for large df
        criticalValue = df > 30 ? zScore : (zScore + 2.36 / df + 2.09 / (df * df));

        // Two-tailed p-value from t-distribution (approximation)
        const tAbs = Math.abs(tStat);
        // Use normal approximation adjusted for df
        const tToZ = tAbs * Math.sqrt(df / (df + tAbs * tAbs / 3));
        pValue = 2 * (1 - normalCDF(tToZ));

        method = 'Knapp-Hartung';
    } else {
        // Standard method without adjustment
        seBeta1 = safeSqrt(varBeta1Base);
        tStat = seBeta1 > 0 ? beta1 / seBeta1 : 0;
        pValue = 2 * (1 - normalCDF(Math.abs(tStat)));
        criticalValue = zScore;
        method = 'Standard';
    }

    // R² analog: proportion of heterogeneity explained
    const qTotal = weights.reduce((s, w, i) => s + w * Math.pow(outcome[i] - meanY, 2), 0);
    const r2 = qTotal > 0 ? Math.max(0, 1 - qRes / qTotal) : 0;

    // Residual tau² (simplified estimation)
    const tau2Residual = Math.max(0, (qRes - df) / (sumW - sumWXX / sumW));

    return {
        intercept: beta0,
        slope: beta1,
        slopeCI: [beta1 - criticalValue * seBeta1, beta1 + criticalValue * seBeta1],
        slopeSE: seBeta1,
        t: tStat,
        df: df,
        pValue: pValue,
        r2: r2 * 100,  // Percentage of heterogeneity explained
        tau2Residual: tau2Residual,
        qResidual: qRes,
        method: method,
        n: n
    };
}

/**
 * Standard normal CDF approximation
 */
function normalCDF(x) {
    const a1 = 0.254829592;
    const a2 = -0.284496736;
    const a3 = 1.421413741;
    const a4 = -1.453152027;
    const a5 = 1.061405429;
    const p = 0.3275911;

    const sign = x < 0 ? -1 : 1;
    x = Math.abs(x) / Math.sqrt(2);

    const t = 1.0 / (1.0 + p * x);
    const y = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * Math.exp(-x * x);

    return 0.5 * (1.0 + sign * y);
}

/**
 * Run meta-regression for both sensitivity and specificity
 * @param {Object[]} studyStats - Study statistics
 * @param {number[]} covariate - Covariate values (must match study order)
 * @param {string} covariateName - Name of the covariate
 * @returns {Object} Meta-regression results for sens and spec
 */
function runMetaRegression(studyStats, covariate, covariateName = 'Covariate') {
    if (!covariate || covariate.length !== studyStats.length) {
        return null;
    }

    // Get baseline tau² from univariate models
    const sensLogits = studyStats.map(s => s.sensLogit);
    const specLogits = studyStats.map(s => s.specLogit);
    const varSens = studyStats.map(s => s.varSensLogit);
    const varSpec = studyStats.map(s => s.varSpecLogit);

    const sensBase = univariateRE(sensLogits, varSens);
    const specBase = univariateRE(specLogits, varSpec);

    if (!sensBase || !specBase) return null;

    const sensReg = metaRegression(sensLogits, varSens, covariate, sensBase.tau2);
    const specReg = metaRegression(specLogits, varSpec, covariate, specBase.tau2);

    return {
        covariateName,
        sensitivity: sensReg,
        specificity: specReg
    };
}

// Store meta-regression results globally
let metaRegressionResults = null;

// SROC curve calculation (Moses-Littenberg approach with inverse-variance weighting)
function calcSROC(studyStats) {
    const k = studyStats.length;
    if (k < 2) return null;

    // D = logit(sens) + logit(spec) ≈ log(DOR), S = logit(sens) - logit(spec) (threshold)
    const D = studyStats.map(s => s.sensLogit + s.specLogit);
    const S = studyStats.map(s => s.sensLogit - s.specLogit);

    // Variance of D (accuracy) - for weighting
    const varD = studyStats.map(s => s.varSensLogit + s.varSpecLogit);

    // Inverse-variance weights
    const weights = varD.map(v => v > 0 ? 1 / v : 1);
    const sumW = weights.reduce((a, b) => a + b, 0);

    // Weighted means
    const meanD = weights.reduce((s, w, i) => s + w * D[i], 0) / sumW;
    const meanS = weights.reduce((s, w, i) => s + w * S[i], 0) / sumW;

    // Weighted regression: D on S
    let sumWSD = 0, sumWSS = 0;
    for (let i = 0; i < k; i++) {
        const w = weights[i];
        sumWSD += w * (S[i] - meanS) * (D[i] - meanD);
        sumWSS += w * (S[i] - meanS) * (S[i] - meanS);
    }

    const beta = sumWSS > 0 ? sumWSD / sumWSS : 0;
    const alpha = meanD - beta * meanS;

    // Standard error of alpha (intercept)
    const seAlpha = safeSqrt(1 / sumW + meanS * meanS / sumWSS);

    // Standard error of beta (slope)
    const seBeta = sumWSS > 0 ? safeSqrt(1 / sumWSS) : 0;

    // Generate SROC curve points
    // From D = α + β*S, solving for sensLogit:
    // sensLogit = (α - (1+β)*specLogit) / (1-β)
    const srocPoints = [];
    const denominator = 1 - beta;

    // Handle near-singular case (β ≈ 1 means perfect symmetry)
    if (Math.abs(denominator) < 0.01) {
        // When β ≈ 1, use simplified symmetric model
        for (let fpr = 0.01; fpr <= 0.99; fpr += 0.01) {
            const specLogit = logit(1 - fpr);
            // Symmetric approximation: sensLogit ≈ α/2 - specLogit
            const sensLogit = alpha / 2 - specLogit;
            const sens = invLogit(sensLogit);
            if (sens > 0.001 && sens < 0.999) {
                srocPoints.push({ fpr, sens });
            }
        }
    } else {
        for (let fpr = 0.01; fpr <= 0.99; fpr += 0.01) {
            const specLogit = logit(1 - fpr);
            // Correct Moses-Littenberg transformation
            const sensLogit = (alpha - (1 + beta) * specLogit) / denominator;
            const sens = invLogit(sensLogit);
            if (sens > 0.001 && sens < 0.999) {
                srocPoints.push({ fpr, sens });
            }
        }
    }

    // AUC approximation using trapezoidal rule
    let auc = 0;
    for (let i = 1; i < srocPoints.length; i++) {
        const dx = srocPoints[i].fpr - srocPoints[i-1].fpr;
        const avgSens = (srocPoints[i].sens + srocPoints[i-1].sens) / 2;
        auc += dx * avgSens;
    }

    // AUC standard error using delta method from SROC parameters
    // Var(AUC) ≈ (∂AUC/∂α)² × Var(α) + (∂AUC/∂β)² × Var(β)
    // For Moses-Littenberg: AUC ≈ Φ(α/√2) where Φ is standard normal CDF
    // ∂AUC/∂α ≈ φ(α/√2)/√2 where φ is standard normal PDF
    const phi = Math.exp(-alpha * alpha / 4) / Math.sqrt(2 * Math.PI);
    const dAUCdAlpha = phi / Math.sqrt(2);
    // ∂AUC/∂β is complex; use numerical approximation based on variance propagation
    const varAUC = dAUCdAlpha * dAUCdAlpha * seAlpha * seAlpha +
                   (auc * (1 - auc) / (k * k)) * seBeta * seBeta;  // Second term from beta contribution
    const seAUC = safeSqrt(Math.max(varAUC, auc * (1 - auc) / k));  // Conservative: max of methods

    // Q* index (where sens = spec on SROC)
    const qStar = invLogit(alpha / 2);

    // D-prime (discriminability index)
    const dPrime = alpha / Math.sqrt(2);

    // Partial AUC (for FPR 0-0.2, clinically relevant range)
    let partialAUC = 0;
    const partialPoints = srocPoints.filter(p => p.fpr <= 0.2);
    for (let i = 1; i < partialPoints.length; i++) {
        const dx = partialPoints[i].fpr - partialPoints[i-1].fpr;
        const avgSens = (partialPoints[i].sens + partialPoints[i-1].sens) / 2;
        partialAUC += dx * avgSens;
    }
    // Normalize to 0-1 range
    partialAUC = partialAUC / 0.2;

    return {
        points: srocPoints,
        alpha,
        beta,
        seAlpha,
        seBeta,
        auc: Math.max(0.5, Math.min(1, auc)),
        aucCI: [Math.max(0.5, auc - 1.96 * seAUC), Math.min(1, auc + 1.96 * seAUC)],
        partialAUC: Math.max(0, Math.min(1, partialAUC)),
        qStar,
        dPrime,
        weighted: true,
        k: k
    };
}

// Threshold effect test (Spearman correlation)
function thresholdEffectTest(studyStats) {
    const k = studyStats.length;
    if (k < 4) return { rho: null, p: null };
    
    const sens = studyStats.map(s => s.sens);
    const spec = studyStats.map(s => s.spec);
    
    // Rank the values
    function rank(arr) {
        const sorted = arr.map((v, i) => ({ v, i })).sort((a, b) => a.v - b.v);
        const ranks = new Array(arr.length);
        sorted.forEach((item, r) => { ranks[item.i] = r + 1; });
        return ranks;
    }
    
    const rankSens = rank(sens);
    const rankSpec = rank(spec);
    
    // Spearman correlation
    let sumD2 = 0;
    for (let i = 0; i < k; i++) {
        const d = rankSens[i] - rankSpec[i];
        sumD2 += d * d;
    }
    const rho = 1 - (6 * sumD2) / (k * (k * k - 1));
    
    // Approximate p-value using t-distribution
    const t = rho * Math.sqrt((k - 2) / (1 - rho * rho));
    // Simple approximation for p-value
    const p = 2 * (1 - normalCDF(Math.abs(t) * Math.sqrt(k / 10)));
    
    return { rho, p };
}

// Normal CDF approximation
function normalCDF(x) {
    const a1 = 0.254829592, a2 = -0.284496736, a3 = 1.421413741;
    const a4 = -1.453152027, a5 = 1.061405429, p = 0.3275911;
    const sign = x < 0 ? -1 : 1;
    x = Math.abs(x) / Math.sqrt(2);
    const t = 1 / (1 + p * x);
    const y = 1 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * Math.exp(-x * x);
    return 0.5 * (1 + sign * y);
}

// Deeks' funnel plot asymmetry test
function deeksFunnelTest(studyStats) {
    const k = studyStats.length;
    if (k < 5) return { slope: null, p: null };
    
    // ESS = 4 * (TP+FN) * (FP+TN) / (TP+FP+FN+TN)
    const ess = studyStats.map(s => 4 * s.diseased * s.healthy / s.total);
    const invSqrtESS = ess.map(e => 1 / Math.sqrt(e));
    const logDOR = studyStats.map(s => s.logDOR);
    
    // Linear regression: logDOR ~ 1/sqrt(ESS)
    const meanX = invSqrtESS.reduce((a, b) => a + b, 0) / k;
    const meanY = logDOR.reduce((a, b) => a + b, 0) / k;
    
    let sumXY = 0, sumXX = 0, sumYY = 0;
    for (let i = 0; i < k; i++) {
        const dx = invSqrtESS[i] - meanX;
        const dy = logDOR[i] - meanY;
        sumXY += dx * dy;
        sumXX += dx * dx;
        sumYY += dy * dy;
    }
    
    const slope = sumXY / sumXX;
    const intercept = meanY - slope * meanX;
    
    // R-squared and standard error of slope
    const ssRes = sumYY - slope * sumXY;
    const mse = ssRes / (k - 2);
    const seSlope = Math.sqrt(mse / sumXX);
    
    // t-test for slope
    const t = slope / seSlope;
    const p = 2 * (1 - normalCDF(Math.abs(t)));
    
    return {
        slope,
        intercept,
        p,
        ess,
        invSqrtESS,
        logDOR
    };
}

/**
 * Leave-one-out sensitivity analysis
 * Recalculates meta-analysis excluding each study one at a time
 * @param {Object[]} studyStats - Array of study statistics
 * @param {string} modelType - Model type to use
 * @param {number} zScore - Z-score for confidence intervals
 * @returns {Object} Sensitivity analysis results
 */
function leaveOneOutAnalysis(studyStats, modelType = 'bivariate', zScore = STAT_CONSTANTS.Z_95) {
    const k = studyStats.length;
    if (k < 4) return null;  // Need at least 4 studies (3 after exclusion)

    const results = [];
    let baseSens = null, baseSpec = null;

    // Get baseline results with all studies
    const baseResult = runSelectedModel(modelType, studyStats, zScore);
    if (baseResult) {
        baseSens = baseResult.sensitivity.estimate;
        baseSpec = baseResult.specificity.estimate;
    }

    // Leave-one-out analysis
    for (let i = 0; i < k; i++) {
        const subset = studyStats.filter((_, idx) => idx !== i);
        const result = runSelectedModel(modelType, subset, zScore);

        if (result) {
            const sens = result.sensitivity.estimate;
            const spec = result.specificity.estimate;
            const sensChange = baseSens ? ((sens - baseSens) / baseSens) * 100 : 0;
            const specChange = baseSpec ? ((spec - baseSpec) / baseSpec) * 100 : 0;

            results.push({
                excludedStudy: studyStats[i].studyName || `Study ${i + 1}`,
                excludedIndex: i,
                sensitivity: {
                    estimate: sens,
                    ci: result.sensitivity.ci,
                    change: sensChange
                },
                specificity: {
                    estimate: spec,
                    ci: result.specificity.ci,
                    change: specChange
                },
                I2Sens: result.sensitivity.I2,
                I2Spec: result.specificity.I2,
                DOR: result.DOR ? result.DOR.estimate : null
            });
        }
    }

    // Identify influential studies (>10% change in either metric)
    const influential = results.filter(r =>
        Math.abs(r.sensitivity.change) > 10 || Math.abs(r.specificity.change) > 10
    );

    // Calculate summary statistics
    const sensEstimates = results.map(r => r.sensitivity.estimate);
    const specEstimates = results.map(r => r.specificity.estimate);

    return {
        results,
        baseline: { sensitivity: baseSens, specificity: baseSpec },
        influential,
        summary: {
            sensRange: [Math.min(...sensEstimates), Math.max(...sensEstimates)],
            specRange: [Math.min(...specEstimates), Math.max(...specEstimates)],
            sensSD: safeSqrt(sensEstimates.reduce((s, v) => s + Math.pow(v - baseSens, 2), 0) / k),
            specSD: safeSqrt(specEstimates.reduce((s, v) => s + Math.pow(v - baseSpec, 2), 0) / k)
        },
        k: results.length
    };
}

// Store sensitivity analysis results globally
let sensitivityAnalysisResults = null;

/**
 * Run and display leave-one-out sensitivity analysis
 */
function runSensitivityAnalysis() {
    const validStudies = studies.filter(s =>
        s.tp !== '' && s.fp !== '' && s.fn !== '' && s.tn !== '' &&
        s.tp >= 0 && s.fp >= 0 && s.fn >= 0 && s.tn >= 0
    );

    if (validStudies.length < 4) {
        alert('Need at least 4 studies for sensitivity analysis.');
        return;
    }

    const studyStats = validStudies.map(calcStudyStats);
    const modelType = document.getElementById('modelSelect')?.value || 'bivariate';
    const zScore = getCurrentZScore();

    sensitivityAnalysisResults = leaveOneOutAnalysis(studyStats, modelType, zScore);

    if (sensitivityAnalysisResults) {
        displaySensitivityAnalysis(sensitivityAnalysisResults);
    }
}

/**
 * Display sensitivity analysis results
 * @param {Object} results - Leave-one-out analysis results
 */
function displaySensitivityAnalysis(results) {
    const container = document.getElementById('sensitivityResults');
    if (!container) return;

    let html = '<div class="sensitivity-table-wrap"><table class="results-table">';
    html += '<thead><tr>';
    html += '<th>Excluded Study</th>';
    html += '<th>Sensitivity</th>';
    html += '<th>Change</th>';
    html += '<th>Specificity</th>';
    html += '<th>Change</th>';
    html += '<th>I² Sens</th>';
    html += '</tr></thead><tbody>';

    results.results.forEach(r => {
        const sensChangeClass = Math.abs(r.sensitivity.change) > 10 ? 'influential' : '';
        const specChangeClass = Math.abs(r.specificity.change) > 10 ? 'influential' : '';

        html += `<tr class="${sensChangeClass || specChangeClass ? 'highlight-row' : ''}">`;
        html += `<td>${escapeHtml(r.excludedStudy)}</td>`;
        html += `<td>${(r.sensitivity.estimate * 100).toFixed(1)}% (${(r.sensitivity.ci[0] * 100).toFixed(1)}-${(r.sensitivity.ci[1] * 100).toFixed(1)})</td>`;
        html += `<td class="${sensChangeClass}">${r.sensitivity.change >= 0 ? '+' : ''}${r.sensitivity.change.toFixed(1)}%</td>`;
        html += `<td>${(r.specificity.estimate * 100).toFixed(1)}% (${(r.specificity.ci[0] * 100).toFixed(1)}-${(r.specificity.ci[1] * 100).toFixed(1)})</td>`;
        html += `<td class="${specChangeClass}">${r.specificity.change >= 0 ? '+' : ''}${r.specificity.change.toFixed(1)}%</td>`;
        html += `<td>${r.I2Sens !== undefined ? r.I2Sens.toFixed(1) + '%' : '—'}</td>`;
        html += '</tr>';
    });

    html += '</tbody></table></div>';

    // Summary
    html += '<div class="sensitivity-summary" style="margin-top: 1rem;">';
    html += '<h4>Summary</h4>';
