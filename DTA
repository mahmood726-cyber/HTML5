    const sens = m.sensitivity.estimate;
    const spec = m.specificity.estimate;
    const plr = m.PLR.estimate;
    const nlr = m.NLR.estimate;

    if (sens >= 0.9 && spec >= 0.9) {
        interp = 'This test demonstrates excellent diagnostic accuracy with both high sensitivity and specificity. It is suitable for both screening and confirmatory purposes.';
    } else if (sens >= 0.9) {
        interp = `This test has high sensitivity (${(sens*100).toFixed(0)}%), making it useful for ruling OUT the condition when negative (SnNout). A negative result substantially decreases the probability of disease.`;
    } else if (spec >= 0.9) {
        interp = `This test has high specificity (${(spec*100).toFixed(0)}%), making it useful for ruling IN the condition when positive (SpPin). A positive result substantially increases the probability of disease.`;
    } else {
        interp = 'This test has moderate diagnostic accuracy. Consider using it in combination with other tests or clinical findings.';
    }

    if (plr > 10) {
        interp += ` The positive likelihood ratio of ${plr.toFixed(1)} indicates that a positive result provides strong evidence for the presence of disease.`;
    } else if (plr > 5) {
        interp += ` The positive likelihood ratio of ${plr.toFixed(1)} indicates moderate evidence for disease when positive.`;
    }

    if (nlr < 0.1) {
        interp += ` The negative likelihood ratio of ${nlr.toFixed(2)} provides strong evidence against disease when the test is negative.`;
    } else if (nlr < 0.2) {
        interp += ` The negative likelihood ratio of ${nlr.toFixed(2)} provides moderate evidence against disease when negative.`;
    }

    // Add model-specific notes
    if (actualModel === 'hsroc') {
        interp += ' (Analysis performed using HSROC model which accounts for threshold variation across studies.)';
    } else if (actualModel === 'univariate' || actualModel === 'univariate (fallback)') {
        interp += ' (Note: Univariate analysis does not account for correlation between sensitivity and specificity.)';
    }

    document.getElementById('interpretationText').textContent = interp;

    // Display convergence warning if applicable
    const convergenceAlert = document.getElementById('convergenceAlert');
    if (convergenceAlert) {
        if (m.convergence && !m.convergence.converged) {
            convergenceAlert.innerHTML = `<strong>Warning:</strong> REML estimation did not converge after ${m.convergence.iterations} iterations. ` +
                                         `Results may be unreliable. Consider using HSROC or univariate model.`;
            convergenceAlert.style.display = 'block';
            convergenceAlert.className = 'alert alert-warning';
        } else if (m.warning) {
            convergenceAlert.innerHTML = `<strong>Note:</strong> ${m.warning}`;
            convergenceAlert.style.display = 'block';
            convergenceAlert.className = 'alert alert-info';
        } else if (m.convergence && m.convergence.converged) {
            convergenceAlert.innerHTML = `REML converged in ${m.convergence.iterations} iterations (tolerance: ${m.convergence.tolerance.toExponential(1)})`;
            convergenceAlert.style.display = 'block';
            convergenceAlert.className = 'alert alert-success';
        } else {
            convergenceAlert.style.display = 'none';
        }
    }
}

function updateHeterogeneityView() {
    if (!results) return;
    const m = results.model;
    const t = results.threshold;

    // I² values with confidence intervals
    const sensI2CI = m.sensitivity.I2CI;
    const specI2CI = m.specificity.I2CI;

    let sensI2Text = m.sensitivity.I2.toFixed(1) + '%';
    let specI2Text = m.specificity.I2.toFixed(1) + '%';

    // Add CI if available
    if (sensI2CI && sensI2CI[0] !== undefined) {
        sensI2Text += ` (${sensI2CI[0].toFixed(0)}–${sensI2CI[1].toFixed(0)}%)`;
    }
    if (specI2CI && specI2CI[0] !== undefined) {
        specI2Text += ` (${specI2CI[0].toFixed(0)}–${specI2CI[1].toFixed(0)}%)`;
    }

    document.getElementById('i2Sens').textContent = sensI2Text;
    document.getElementById('i2Spec').textContent = specI2Text;

    // Heterogeneity level labels
    function hetLevel(i2) {
        if (i2 < 25) return 'Low';
        if (i2 < 50) return 'Moderate';
        if (i2 < 75) return 'Substantial';
        return 'Considerable';
    }

    document.getElementById('i2SensLevel').textContent = hetLevel(m.sensitivity.I2);
    document.getElementById('i2SpecLevel').textContent = hetLevel(m.specificity.I2);

    // Tau² values
    document.getElementById('tauSens').textContent = m.sensitivity.tau2.toFixed(4);
    document.getElementById('tauSpec').textContent = m.specificity.tau2.toFixed(4);

    // Correlation (handle null case)
    const corrValue = document.getElementById('corrValue');
    if (m.correlation !== null && m.correlation !== undefined) {
        corrValue.textContent = m.correlation.toFixed(3);
    } else {
        corrValue.textContent = 'Not estimable';
    }

    // Threshold effect
    if (t && t.rho !== null) {
        document.getElementById('spearmanRho').textContent = t.rho.toFixed(3);
        document.getElementById('thresholdP').textContent = t.p < 0.001 ? '<0.001' : t.p.toFixed(3);

        const thresholdSig = t.p < 0.05;
        document.getElementById('hetAlert').className = `alert ${thresholdSig ? 'alert-warning' : 'alert-success'}`;
        document.getElementById('hetAlert').innerHTML = thresholdSig ?
            '<strong>Threshold effect detected:</strong> The significant Spearman correlation suggests studies may have used different test thresholds, which could explain heterogeneity.' :
            '<strong>No significant threshold effect:</strong> Heterogeneity is unlikely to be explained by threshold variation alone.';
    }
}

