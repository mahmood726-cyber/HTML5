const STORAGE_KEY = 'dta_session_data';

/**
 * Save current session data to localStorage
 */
function saveSession() {
    try {
        const sessionData = {
            studies: studies,
            modelType: currentModel,
            ciLevel: currentCILevel,
            savedAt: new Date().toISOString(),
            version: '2.0'
        };
        localStorage.setItem(STORAGE_KEY, JSON.stringify(sessionData));
        showToast('Session saved to browser storage');
    } catch (e) {
        console.error('Failed to save session:', e);
        showToast('Failed to save session: ' + e.message, 'error');
    }
}

/**
 * Load session data from localStorage
 */
function loadSession() {
    try {
        const savedData = localStorage.getItem(STORAGE_KEY);
        if (!savedData) {
            showToast('No saved session found', 'warning');
            return;
        }

        const sessionData = JSON.parse(savedData);

        // Validate and load studies
        if (sessionData.studies && Array.isArray(sessionData.studies)) {
            studies = sessionData.studies.map(s => ({
                id: s.id || Date.now() + Math.random(),
                name: validateStudyName(s.name),
                tp: s.tp ?? '',
                fp: s.fp ?? '',
                fn: s.fn ?? '',
                tn: s.tn ?? '',
                quadas: s.quadas || { patient: 'low', index: 'low', reference: 'low', flow: 'low' }
            }));
        }

        // Restore model selection
        if (sessionData.modelType) {
            currentModel = sessionData.modelType;
            const modelSelect = document.getElementById('modelSelect');
            if (modelSelect) modelSelect.value = currentModel;
        }

        // Restore CI level
        if (sessionData.ciLevel) {
            currentCILevel = sessionData.ciLevel;
            const ciSelect = document.getElementById('ciSelect');
            if (ciSelect) ciSelect.value = currentCILevel.toString();
        }

        // Update UI
        renderDataTable();
        updateQuickStats();

        const savedDate = sessionData.savedAt ? new Date(sessionData.savedAt).toLocaleString() : 'unknown';
        showToast(`Session loaded (saved ${savedDate})`);
    } catch (e) {
        console.error('Failed to load session:', e);
        showToast('Failed to load session: ' + e.message, 'error');
    }
}

/**
 * Clear saved session from localStorage
 */
function clearSession() {
    try {
        localStorage.removeItem(STORAGE_KEY);
        showToast('Saved session cleared');
    } catch (e) {
        console.error('Failed to clear session:', e);
        showToast('Failed to clear session: ' + e.message, 'error');
    }
}

/**
 * Check if there is a saved session available
 * @returns {boolean} True if session exists
 */
function hasSavedSession() {
    return localStorage.getItem(STORAGE_KEY) !== null;
}

/**
 * Auto-save session periodically (every 30 seconds if data exists)
 */
function setupAutoSave() {
    setInterval(() => {
        if (studies.length > 0 && studies.some(s => s.tp !== '' || s.fp !== '' || s.fn !== '' || s.tn !== '')) {
            try {
                const sessionData = {
                    studies: studies,
                    modelType: currentModel,
                    ciLevel: currentCILevel,
                    savedAt: new Date().toISOString(),
                    version: '2.0',
                    autoSave: true
                };
                localStorage.setItem(STORAGE_KEY, JSON.stringify(sessionData));
            } catch (e) {
                // Silent fail for auto-save
            }
        }
    }, 30000);
}

