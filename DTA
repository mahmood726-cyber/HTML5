function updateQUADAS(studyId, domain, value) {
    const study = studies.find(s => s.id === studyId);
    if (study) {
        study.quadas[domain] = value;
        renderQUADASGrid();
        plotQUADASSummary();
    }
}

function getOverallRoB(q) {
    const values = [q.patient, q.index, q.reference, q.flow];
    if (values.includes('high')) return 'high';
    if (values.includes('some')) return 'some';
    if (values.includes('unclear')) return 'unclear';
    return 'low';
}

function plotQUADASSummary() {
    if (!isPlotlyReady()) return;
    const c = getPlotColors();
    
    if (studies.length === 0) {
        Plotly.newPlot('quadasSummaryPlot', [], {
            paper_bgcolor: c.paper,
            plot_bgcolor: c.paper
        });
        return;
    }
    
    const domains = ['patient', 'index', 'reference', 'flow'];
    const domainLabels = ['Patient Selection', 'Index Test', 'Reference Standard', 'Flow & Timing'];
    
    const counts = domains.map(domain => {
        const vals = studies.map(s => s.quadas[domain]);
        return {
            low: vals.filter(v => v === 'low').length,
            some: vals.filter(v => v === 'some').length,
            high: vals.filter(v => v === 'high').length,
            unclear: vals.filter(v => v === 'unclear').length
        };
    });
    
    const traces = [
        {
            name: 'Low risk',
            type: 'bar',
            x: domainLabels,
            y: counts.map(c => c.low / studies.length * 100),
            marker: { color: c.success }
        },
        {
            name: 'Some concerns',
            type: 'bar',
            x: domainLabels,
            y: counts.map(c => c.some / studies.length * 100),
            marker: { color: c.warning }
        },
        {
            name: 'High risk',
            type: 'bar',
            x: domainLabels,
            y: counts.map(c => c.high / studies.length * 100),
            marker: { color: c.danger }
        },
        {
            name: 'Unclear',
            type: 'bar',
            x: domainLabels,
            y: counts.map(c => c.unclear / studies.length * 100),
            marker: { color: '#9ca3af' }
        }
    ];
    
    const layout = {
        barmode: 'stack',
        title: { text: 'Risk of Bias Summary', font: { family: 'Crimson Pro', size: 16 } },
        xaxis: { tickangle: -30 },
        yaxis: { title: 'Proportion (%)', range: [0, 100] },
        paper_bgcolor: c.paper,
        plot_bgcolor: c.paper,
        font: { family: 'DM Sans', color: c.text },
        margin: { l: 50, r: 20, t: 50, b: 100 },
        legend: { orientation: 'h', y: -0.3 }
    };
    
    Plotly.newPlot('quadasSummaryPlot', traces, layout, { responsive: true });
    
    // Traffic light plot
    const trafficData = [];
    
    studies.forEach((study, i) => {
        domains.forEach((domain, j) => {
            const val = study.quadas[domain];
            let color = val === 'low' ? c.success : val === 'high' ? c.danger : val === 'some' ? c.warning : '#9ca3af';
            trafficData.push({
                x: [j],
                y: [i],
                mode: 'markers',
                marker: {
                    size: 20,
                    color: color,
                    symbol: val === 'low' ? 'circle' : val === 'high' ? 'x' : 'diamond'
                },
                showlegend: false,
                hoverinfo: 'text',
                text: `${study.name}<br>${domainLabels[j]}: ${val}`
            });
        });
    });
    
    const trafficLayout = {
        title: { text: 'Traffic Light Plot', font: { family: 'Crimson Pro', size: 16 } },
        xaxis: {
            tickvals: [0, 1, 2, 3],
            ticktext: ['PS', 'IT', 'RS', 'F&T'],
            side: 'top'
        },
        yaxis: {
            tickvals: [...Array(studies.length).keys()],
            ticktext: studies.map(s => s.name),
            autorange: 'reversed'
        },
        paper_bgcolor: c.paper,
        plot_bgcolor: c.paper,
        font: { family: 'DM Sans', color: c.text, size: 11 },
        margin: { l: 100, r: 20, t: 50, b: 20 }
    };
    
    Plotly.newPlot('quadasTrafficPlot', trafficData, trafficLayout, { responsive: true });
}

