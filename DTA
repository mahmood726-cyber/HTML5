/**
 * Simple unit test framework
 */
const UnitTests = {
    passed: 0,
    failed: 0,
    results: [],

    assert(condition, message) {
        if (condition) {
            this.passed++;
            this.results.push({ pass: true, message });
        } else {
            this.failed++;
            this.results.push({ pass: false, message });
            console.error('FAIL:', message);
        }
    },

    assertApprox(actual, expected, tolerance, message) {
        const diff = Math.abs(actual - expected);
        this.assert(diff <= tolerance, `${message} (expected: ${expected}, got: ${actual}, diff: ${diff})`);
    },

    assertArrayApprox(actual, expected, tolerance, message) {
        if (actual.length !== expected.length) {
            this.assert(false, `${message} - array length mismatch`);
            return;
        }
        for (let i = 0; i < actual.length; i++) {
            this.assertApprox(actual[i], expected[i], tolerance, `${message} [${i}]`);
        }
    },

    run() {
        this.passed = 0;
        this.failed = 0;
        this.results = [];

        console.log('=== Running Unit Tests ===');

        // Test safeSqrt
        this.testSafeSqrt();

        // Test logit and invLogit
        this.testLogitFunctions();

        // Test Wilson score CI
        this.testWilsonScore();

        // Test calcStudyStats
        this.testCalcStudyStats();

        // Test heterogeneity calculation
        this.testHeterogeneity();

        // Test chi-squared CDF
        this.testChiSquareCDF();

        // Test input validation
        this.testInputValidation();

        // Test escapeHtml
        this.testEscapeHtml();

        // Summary
        console.log(`\n=== Test Results: ${this.passed} passed, ${this.failed} failed ===`);
        return { passed: this.passed, failed: this.failed, results: this.results };
    },

    testSafeSqrt() {
        console.log('Testing safeSqrt...');
        this.assertApprox(safeSqrt(4), 2, 0.0001, 'safeSqrt(4) = 2');
        this.assertApprox(safeSqrt(0), 0, 0.0001, 'safeSqrt(0) = 0');
        this.assertApprox(safeSqrt(-1), 0, 0.0001, 'safeSqrt(-1) = 0 (handles negative)');
        this.assertApprox(safeSqrt(1e-15), 0, 0.0001, 'safeSqrt(tiny negative from FP error) = 0');
    },

    testLogitFunctions() {
        console.log('Testing logit/invLogit...');
        this.assertApprox(logit(0.5), 0, 0.0001, 'logit(0.5) = 0');
        this.assertApprox(invLogit(0), 0.5, 0.0001, 'invLogit(0) = 0.5');
        this.assertApprox(invLogit(logit(0.75)), 0.75, 0.0001, 'invLogit(logit(0.75)) = 0.75');
        this.assertApprox(logit(invLogit(2)), 2, 0.0001, 'logit(invLogit(2)) = 2');

        // Test bounds
        this.assert(isFinite(logit(0.0001)), 'logit handles near-zero');
        this.assert(isFinite(logit(0.9999)), 'logit handles near-one');
    },

    testWilsonScore() {
        console.log('Testing Wilson score CI...');
        // Test case: 80/100 successes
        const ci = wilsonScoreCI(80, 100, 1.96);
        this.assertApprox(ci[0], 0.7098, 0.01, 'Wilson CI lower bound for 80/100');
        this.assertApprox(ci[1], 0.8694, 0.01, 'Wilson CI upper bound for 80/100');

        // Edge case: 0 successes
        const ci0 = wilsonScoreCI(0, 100, 1.96);
        this.assert(ci0[0] >= 0, 'Wilson CI lower >= 0 for 0 successes');
        this.assert(ci0[1] > 0, 'Wilson CI upper > 0 for 0 successes');

        // Edge case: all successes
        const ci100 = wilsonScoreCI(100, 100, 1.96);
        this.assert(ci100[0] < 1, 'Wilson CI lower < 1 for 100% success');
        this.assert(ci100[1] <= 1, 'Wilson CI upper <= 1 for 100% success');
    },

    testCalcStudyStats() {
        console.log('Testing calcStudyStats...');
        // Standard test case
        const study1 = { tp: 90, fp: 10, fn: 10, tn: 90 };
        const stats1 = calcStudyStats(study1);

        this.assertApprox(stats1.sens, 0.9, 0.0001, 'Sensitivity = 90/(90+10) = 0.9');
        this.assertApprox(stats1.spec, 0.9, 0.0001, 'Specificity = 90/(90+10) = 0.9');
        this.assertApprox(stats1.dor, 81, 0.1, 'DOR = (90*90)/(10*10) = 81');

        // Test with zeros (continuity correction applied)
        const study2 = { tp: 50, fp: 0, fn: 0, tn: 50 };
        const stats2 = calcStudyStats(study2);
        this.assert(isFinite(stats2.sens), 'Sens is finite with zero FN');
        this.assert(isFinite(stats2.spec), 'Spec is finite with zero FP');
        this.assert(isFinite(stats2.dor), 'DOR is finite with zeros');
    },

    testHeterogeneity() {
        console.log('Testing heterogeneity calculation...');
        // Homogeneous case: all identical studies
        const homogStats = [
            { sens: 0.8, sensVar: 0.01 },
            { sens: 0.8, sensVar: 0.01 },
            { sens: 0.8, sensVar: 0.01 }
        ];
        const homogHet = calculateHeterogeneity(homogStats, 'sens');
        this.assertApprox(homogHet.I2, 0, 1, 'I² = 0% for homogeneous studies');

        // Heterogeneous case
        const hetStats = [
            { sens: 0.5, sensVar: 0.01 },
            { sens: 0.9, sensVar: 0.01 },
            { sens: 0.5, sensVar: 0.01 }
        ];
        const hetHet = calculateHeterogeneity(hetStats, 'sens');
        this.assert(hetHet.I2 > 0, 'I² > 0% for heterogeneous studies');
        this.assert(hetHet.Q > 0, 'Q > 0 for heterogeneous studies');
    },

    testChiSquareCDF() {
        console.log('Testing chi-squared CDF...');
        // Known values from chi-squared tables
        // χ²(2) at 0.95 quantile is approximately 5.991
        // So P(χ²(2) <= 5.991) ≈ 0.95
        this.assertApprox(chiSquareCDF(5.991, 2), 0.95, 0.01, 'χ²(2) CDF at 5.991 ≈ 0.95');

        // P(χ²(1) <= 3.841) ≈ 0.95
        this.assertApprox(chiSquareCDF(3.841, 1), 0.95, 0.01, 'χ²(1) CDF at 3.841 ≈ 0.95');

        // Edge cases
        this.assertApprox(chiSquareCDF(0, 2), 0, 0.001, 'χ² CDF at 0 = 0');
        this.assert(chiSquareCDF(100, 2) > 0.99, 'χ² CDF at large value ≈ 1');
    },

    testInputValidation() {
        console.log('Testing input validation...');

        // validateNumericInput
        const valid1 = validateNumericInput(50, 0, 1000);
        this.assert(valid1.isValid && valid1.value === 50, 'Valid numeric input accepted');

        const valid2 = validateNumericInput(-5, 0, 1000);
        this.assert(!valid2.isValid, 'Negative value rejected when min=0');

        const valid3 = validateNumericInput(1e10, 0, 1e9);
        this.assert(!valid3.isValid, 'Value above max rejected');

        const valid4 = validateNumericInput('abc', 0, 1000);
        this.assert(!valid4.isValid, 'Non-numeric string rejected');

        // validateStudyName
        const name1 = validateStudyName('Normal Study 2023');
        this.assert(name1 === 'Normal Study 2023', 'Normal study name preserved');

        const name2 = validateStudyName('<script>alert(1)</script>');
        this.assert(!name2.includes('<'), 'HTML tags removed from study name');

        const longName = 'A'.repeat(150);
        const name3 = validateStudyName(longName);
        this.assert(name3.length <= STAT_CONSTANTS.MAX_STUDY_NAME_LENGTH, 'Long name truncated');
    },

    testEscapeHtml() {
        console.log('Testing escapeHtml...');
        this.assert(escapeHtml('<script>') === '&lt;script&gt;', 'Script tag escaped');
        this.assert(escapeHtml('"quote"').includes('&quot;') || escapeHtml('"quote"') === '"quote"', 'Quotes handled');
        this.assert(escapeHtml('normal') === 'normal', 'Normal text unchanged');
        this.assert(escapeHtml(null) === '', 'Null returns empty string');
        this.assert(escapeHtml(undefined) === '', 'Undefined returns empty string');
        this.assert(escapeHtml(123) === '123', 'Numbers converted to string');
    }
};

// Expose test runner to console: UnitTests.run()
window.runTests = () => UnitTests.run();

// ========================
// INITIALIZATION
// ========================
function initApp() {
    // Add initial empty rows
    addStudy();
    addStudy();
    addStudy();
    
    // Update stats
    updateQuickStats();
    
    // Render QUADAS grid
    renderQUADASGrid();
    
    console.log('DTA Meta-Analysis Suite initialized');
}

// Wait for DOM and Plotly to be ready
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initApp);
} else {
    initApp();
}
</script>

