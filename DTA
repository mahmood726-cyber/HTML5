function exportQUADAS() {
    let csv = 'Study,Patient Selection,Index Test,Reference Standard,Flow & Timing,Overall\n';

    studies.forEach(s => {
        const overall = getOverallRoB(s.quadas);
        csv += `${escapeCSV(s.name)},${s.quadas.patient},${s.quadas.index},${s.quadas.reference},${s.quadas.flow},${overall}\n`;
    });

    downloadFile(csv, 'quadas2_assessment.csv', 'text/csv');
    showToast('QUADAS-2 data exported');
}

function downloadFile(content, filename, type) {
    const blob = new Blob([content], { type });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
}

