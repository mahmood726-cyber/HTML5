/**
 * Export study data as CSV file
 */
function exportCSV() {
    const validStudies = studies.filter(s => s.tp !== '' && s.fp !== '' && s.fn !== '' && s.tn !== '');

    if (validStudies.length === 0) {
        showToast('No valid data to export', 'error');
        return;
    }

    let csv = 'Study,TP,FP,FN,TN,Sensitivity,Specificity,DOR\n';

    validStudies.forEach(s => {
        const stats = calcStudyStats(s);
        csv += `${escapeCSV(s.name)},${s.tp},${s.fp},${s.fn},${s.tn},${stats.sens.toFixed(4)},${stats.spec.toFixed(4)},${stats.dor.toFixed(2)}\n`;
    });

    downloadFile(csv, 'dta_data.csv', 'text/csv');
    showToast('Data exported as CSV');
}

