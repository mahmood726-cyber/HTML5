function plotROCSpace() {
    const c = getPlotColors();
    const stats = results.studyStats;
    
    // Plot logit(sens) vs logit(1-spec) to visualize threshold effect
    const trace = {
        type: 'scatter',
        mode: 'markers+text',
        x: stats.map(s => s.sensLogit),
        y: stats.map(s => logit(1 - s.spec)),
        marker: {
            color: c.accent,
            size: 12,
            line: { color: c.paper, width: 2 }
        },
        text: stats.map(s => s.name),
        textposition: 'top center',
        textfont: { size: 10, color: c.text },
        hovertemplate: '<b>%{text}</b><br>logit(Sens): %{x:.2f}<br>logit(1-Spec): %{y:.2f}<extra></extra>'
    };
    
    // Regression line for threshold effect
    const xs = stats.map(s => s.sensLogit);
    const ys = stats.map(s => logit(1 - s.spec));
    const meanX = xs.reduce((a, b) => a + b, 0) / xs.length;
    const meanY = ys.reduce((a, b) => a + b, 0) / ys.length;
    
    let sumXY = 0, sumXX = 0;
    for (let i = 0; i < xs.length; i++) {
        sumXY += (xs[i] - meanX) * (ys[i] - meanY);
        sumXX += (xs[i] - meanX) * (xs[i] - meanX);
    }
    const slope = sumXX > 0 ? sumXY / sumXX : 0;
    const intercept = meanY - slope * meanX;
    
    const minX = Math.min(...xs) - 0.5;
    const maxX = Math.max(...xs) + 0.5;
    
    const regressionLine = {
        type: 'scatter',
        mode: 'lines',
        name: 'Threshold trend',
        x: [minX, maxX],
        y: [intercept + slope * minX, intercept + slope * maxX],
        line: { color: c.sensitivity, dash: 'dash', width: 2 }
    };
    
    const layout = {
        title: { text: 'ROC Space (Threshold Effect)', font: { family: 'Crimson Pro', size: 16 } },
        xaxis: { 
            title: 'logit(Sensitivity)',
            gridcolor: c.grid
        },
        yaxis: { 
            title: 'logit(1 - Specificity)',
            gridcolor: c.grid
        },
        paper_bgcolor: c.paper,
        plot_bgcolor: c.paper,
        font: { family: 'DM Sans', color: c.text },
        margin: { l: 60, r: 40, t: 60, b: 60 },
        showlegend: true,
        legend: { x: 0.02, y: 0.98 }
    };
    
    Plotly.newPlot('rocSpacePlot', [trace, regressionLine], layout, { responsive: true });
}

