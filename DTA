<script>
// ========================
// PERFORMANCE MONITORING
// ========================
const Perf = {
    marks: new Map(),
    measurements: new Map(),
    enabled: true,

    start(label) {
        if (!this.enabled) return;
        this.marks.set(label, performance.now());
    },

    end(label) {
        if (!this.enabled || !this.marks.has(label)) return 0;
        const duration = performance.now() - this.marks.get(label);
        if (!this.measurements.has(label)) {
            this.measurements.set(label, []);
        }
        this.measurements.get(label).push(duration);
        this.marks.delete(label);
        return duration;
    },

    getStats(label) {
        const times = this.measurements.get(label);
        if (!times || times.length === 0) return null;
        const sum = times.reduce((a, b) => a + b, 0);
        const avg = sum / times.length;
        const min = Math.min(...times);
        const max = Math.max(...times);
        return { count: times.length, avg: avg.toFixed(2), min: min.toFixed(2), max: max.toFixed(2), total: sum.toFixed(2) };
    },

    report() {
        console.group('⚡ Performance Report');
        for (const [label, times] of this.measurements) {
            const stats = this.getStats(label);
            console.log(`${label}: avg=${stats.avg}ms, min=${stats.min}ms, max=${stats.max}ms, calls=${stats.count}`);
        }
        console.groupEnd();
        return Object.fromEntries([...this.measurements.keys()].map(k => [k, this.getStats(k)]));
    },

    clear() {
        this.marks.clear();
        this.measurements.clear();
    },

    benchmark(fn, label, iterations = 100) {
        const times = [];
        for (let i = 0; i < iterations; i++) {
            const start = performance.now();
            fn();
            times.push(performance.now() - start);
        }
        const avg = times.reduce((a, b) => a + b, 0) / iterations;
        console.log(`Benchmark "${label}": ${avg.toFixed(3)}ms avg over ${iterations} iterations`);
        return avg;
    }
};

// ========================
// UTILITY FUNCTIONS
// ========================

// Debounce function for input handlers
function debounce(fn, delay = 150) {
    let timeoutId;
    return function (...args) {
        clearTimeout(timeoutId);
        timeoutId = setTimeout(() => fn.apply(this, args), delay);
    };
}

// Throttle function for continuous updates
function throttle(fn, limit = 16) {
    let inThrottle;
    return function (...args) {
        if (!inThrottle) {
            fn.apply(this, args);
            inThrottle = true;
            setTimeout(() => inThrottle = false, limit);
        }
    };
}

// Memoization for expensive calculations
function memoize(fn) {
    const cache = new Map();
    return function (...args) {
        const key = JSON.stringify(args);
        if (cache.has(key)) return cache.get(key);
        const result = fn.apply(this, args);
        cache.set(key, result);
        if (cache.size > 100) { // Limit cache size
            const firstKey = cache.keys().next().value;
            cache.delete(firstKey);
        }
        return result;
    };
}

// DOM element cache
const DOM = {
    cache: new Map(),
    get(id) {
        if (!this.cache.has(id)) {
            this.cache.set(id, document.getElementById(id));
        }
        return this.cache.get(id);
    },
    clear() {
        this.cache.clear();
    }
};

// ========================
// SECURITY UTILITIES
// ========================
const Security = {
    // Escape HTML to prevent XSS
    escapeHtml(str) {
        if (typeof str !== 'string') return str;
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    },

    // Sanitize numeric input
    sanitizeNumber(value, defaultVal = '') {
        if (value === '' || value === null || value === undefined) return defaultVal;
        const num = parseFloat(value);
        if (isNaN(num) || num < 0 || num > 1e9) return defaultVal;
        return Math.floor(num);
    },

    // Validate study name
    sanitizeName(name) {
        if (typeof name !== 'string') return 'Study';
        return name.slice(0, 100).replace(/[<>\"'&]/g, '');
    }
};

// ========================
// UNDO/REDO SYSTEM
// ========================
const History = {
    past: [],
    future: [],
    maxSize: 50,

    save() {
        const state = JSON.stringify(studies);
        if (this.past.length > 0 && this.past[this.past.length - 1] === state) return;
        this.past.push(state);
        if (this.past.length > this.maxSize) this.past.shift();
        this.future = [];
        this.updateButtons();
    },

    undo() {
        if (this.past.length <= 1) return;
        this.future.push(this.past.pop());
        const state = this.past[this.past.length - 1];
        studies = JSON.parse(state);
        renderDataTable();
        updateQuickStats();
        this.updateButtons();
        showToast('Undo successful');
    },

    redo() {
        if (this.future.length === 0) return;
        const state = this.future.pop();
        this.past.push(state);
        studies = JSON.parse(state);
        renderDataTable();
        updateQuickStats();
        this.updateButtons();
        showToast('Redo successful');
    },

    updateButtons() {
        const undoBtn = document.getElementById('undoBtn');
        const redoBtn = document.getElementById('redoBtn');
        if (undoBtn) undoBtn.disabled = this.past.length <= 1;
        if (redoBtn) redoBtn.disabled = this.future.length === 0;
    },

    init() {
        this.save(); // Save initial state
    }
};

