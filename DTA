function addStudy(data = {}) {
    try {
        const study = {
            id: Date.now() + Math.random(),
            name: Security.sanitizeName(data.name) || `Study ${studies.length + 1}`,
            tp: Security.sanitizeNumber(data.tp, ''),
            fp: Security.sanitizeNumber(data.fp, ''),
            fn: Security.sanitizeNumber(data.fn, ''),
            tn: Security.sanitizeNumber(data.tn, ''),
            quadas: {
                patient: 'low',
