function initApp() {
    // Try to load saved data first
    const hasData = Storage.load();

    if (hasData && studies.length > 0) {
        showToast(`Restored ${studies.length} studies from previous session`);
    } else {
        // Add initial empty rows if no saved data
        addStudy();
        addStudy();
        addStudy();
    }

    // Initialize history with current state
    History.init();

    // Update UI
    updateQuickStats();
    renderQUADASGrid();

    // Setup keyboard shortcuts
    setupKeyboardShortcuts();

    console.log('DTA Meta-Analysis Suite v2.1 initialized');
    console.log('Available commands: runBenchmark(), Perf.report(), History.undo(), History.redo()');
}

// ========================
// KEYBOARD SHORTCUTS
// ========================
function setupKeyboardShortcuts() {
    document.addEventListener('keydown', (e) => {
        // Check for modifier key (Ctrl on Windows/Linux, Cmd on Mac)
        const modifier = e.ctrlKey || e.metaKey;

        if (modifier) {
            switch (e.key.toLowerCase()) {
                case 'z':
                    if (e.shiftKey) {
                        e.preventDefault();
                        History.redo();
                    } else {
                        e.preventDefault();
                        History.undo();
                    }
                    break;
                case 'y':
                    e.preventDefault();
                    History.redo();
                    break;
                case 's':
                    e.preventDefault();
                    Storage.save();
                    showToast('Data saved');
                    break;
                case 'o':
                    e.preventDefault();
                    importCSV();
                    break;
                case 'enter':
                    e.preventDefault();
                    runAnalysis();
                    break;
            }
        }

        // Non-modifier shortcuts
        if (e.key === 'Escape') {
            // Close any open modals or reset focus
            document.activeElement?.blur();
        }
    });
}

