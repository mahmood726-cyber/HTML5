/**
 * Get the minimum number of studies required for the selected model
 * @param {string} modelType - Model type identifier
 * @returns {number} Minimum number of studies
 */
function getMinStudiesForModel(modelType) {
    switch (modelType) {
        case 'bivariate':
        case 'hsroc':
            return STAT_CONSTANTS.MIN_STUDIES_BIVARIATE;
        case 'univariate':
            return STAT_CONSTANTS.MIN_STUDIES_UNIVARIATE;
        default:
            return STAT_CONSTANTS.MIN_STUDIES_BIVARIATE;
    }
}

/**
 * Run the selected model on study statistics
 * @param {string} modelType - Model type ('bivariate', 'hsroc', 'univariate')
 * @param {Object[]} studyStats - Array of study statistics
 * @returns {Object|null} Model results or null on failure
 */
function runSelectedModel(modelType, studyStats) {
    switch (modelType) {
        case 'bivariate':
            return bivariateModel(studyStats);
        case 'hsroc':
            return hsrocModel(studyStats);
        case 'univariate':
            return univariateModel(studyStats);
        default:
            return bivariateModel(studyStats);
    }
}

/**
 * Main analysis function - orchestrates the DTA meta-analysis
 * Includes error handling and model selection
 */
function runAnalysis() {
    try {
        // Get selected model type
        const modelSelect = document.getElementById('modelSelect');
        currentModel = modelSelect ? modelSelect.value : 'bivariate';

        // Filter valid studies
        const validStudies = studies.filter(s =>
            s.tp !== '' && s.fp !== '' && s.fn !== '' && s.tn !== '' &&
            s.tp >= 0 && s.fp >= 0 && s.fn >= 0 && s.tn >= 0
        );

        const minStudies = getMinStudiesForModel(currentModel);
        if (validStudies.length < minStudies) {
            showToast(`Need at least ${minStudies} valid studies for ${currentModel} model`, 'error');
            return;
        }

        // Calculate study-level statistics
        const studyStats = validStudies.map(s => ({
            ...calcStudyStats(s),
            name: s.name,
            quadas: s.quadas
        }));

        // Run selected model
        let model = runSelectedModel(currentModel, studyStats);

        // Fallback to univariate if primary model fails
        if (!model && currentModel !== 'univariate') {
            showToast(`${currentModel} model failed, falling back to univariate`, 'warning');
            model = univariateModel(studyStats);
            if (model) model.modelType = 'univariate (fallback)';
        }

        if (!model) {
            showToast('Error: Could not run any model on this data', 'error');
            return;
        }

        // SROC curve
        const sroc = calcSROC(studyStats);

        // Threshold effect test
        const threshold = thresholdEffectTest(studyStats);

        // Deeks' funnel test for publication bias
        const deeks = deeksFunnelTest(studyStats);

        // Store results globally
        results = {
            model,
            sroc,
            threshold,
            deeks,
            studyStats,
            k: validStudies.length,
            modelType: model.modelType || currentModel
        };

        // Update all views
        updateSummaryView();
        updateAllPlots();
        updateHeterogeneityView();
        updateNomogram();
        generateRCode();

        const modelLabel = model.modelType || currentModel;
        showToast(`Analysis complete: ${validStudies.length} studies (${modelLabel} model)`);

    } catch (error) {
        console.error('Analysis error:', error);
        showToast('Analysis failed: ' + (error.message || 'Unknown error'), 'error');
    }
}

