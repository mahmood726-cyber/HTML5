};

// ========================
// CSV IMPORT/EXPORT
// ========================
const CSVHandler = {
    parse(csvText) {
        const lines = csvText.trim().split(/\r?\n/);
        if (lines.length < 2) throw new Error('CSV must have header and at least one data row');

        const header = lines[0].toLowerCase().split(',').map(h => h.trim());
        const requiredCols = ['tp', 'fp', 'fn', 'tn'];
        const colIndex = {};

        // Find column indices
        requiredCols.forEach(col => {
            const idx = header.findIndex(h => h === col || h.includes(col));
            if (idx === -1) throw new Error(`Missing required column: ${col}`);
            colIndex[col] = idx;
        });

        // Find optional study/name column
        const nameIdx = header.findIndex(h => h === 'study' || h === 'name' || h === 'author');

        const parsedStudies = [];
        for (let i = 1; i < lines.length; i++) {
            const values = this.parseCSVLine(lines[i]);
            if (values.length < 4) continue;

            const study = {
                name: nameIdx >= 0 ? Security.sanitizeName(values[nameIdx]) : `Study ${i}`,
                tp: Security.sanitizeNumber(values[colIndex.tp]),
                fp: Security.sanitizeNumber(values[colIndex.fp]),
                fn: Security.sanitizeNumber(values[colIndex.fn]),
                tn: Security.sanitizeNumber(values[colIndex.tn])
            };

            if (study.tp !== '' && study.fp !== '' && study.fn !== '' && study.tn !== '') {
                parsedStudies.push(study);
            }
        }

        return parsedStudies;
    },

    parseCSVLine(line) {
        const values = [];
        let current = '';
        let inQuotes = false;

        for (let i = 0; i < line.length; i++) {
            const char = line[i];
            if (char === '"') {
                inQuotes = !inQuotes;
            } else if (char === ',' && !inQuotes) {
                values.push(current.trim());
                current = '';
            } else {
                current += char;
            }
        }
        values.push(current.trim());
        return values;
    },

    import(file) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = (e) => {
                try {
                    const parsedStudies = this.parse(e.target.result);
                    resolve(parsedStudies);
                } catch (err) {
                    reject(err);
                }
            };
            reader.onerror = () => reject(new Error('Failed to read file'));
            reader.readAsText(file);
        });
    }
};

