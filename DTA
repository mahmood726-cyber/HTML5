  TN = c(${tnValues})
)

# View the data
print(data)
${modelCode}

# ============================================
# Summary Estimates
# ============================================

# Calculate pooled estimates
pooled <- madad(data)
cat("\\n=== Summary Statistics ===\\n")
cat("Pooled Sensitivity:", round(pooled$sens$sens, 4),
    "(${ciPercent}% CI:", round(pooled$sens$sens.ci[1], 4), "-",
    round(pooled$sens$sens.ci[2], 4), ")\\n")
cat("Pooled Specificity:", round(pooled$spec$spec, 4),
    "(${ciPercent}% CI:", round(pooled$spec$spec.ci[1], 4), "-",
    round(pooled$spec$spec.ci[2], 4), ")\\n")

# ============================================
# Heterogeneity Assessment
# ============================================
cat("\\n=== Heterogeneity ===\\n")
cat("I² Sensitivity:", round(pooled$sens$I2, 1), "%\\n")
cat("I² Specificity:", round(pooled$spec$I2, 1), "%\\n")

# Cochran's Q test
cat("Q Sensitivity:", round(pooled$sens$Q, 2),
    "(p =", round(pooled$sens$pval, 4), ")\\n")
cat("Q Specificity:", round(pooled$spec$Q, 2),
    "(p =", round(pooled$spec$pval, 4), ")\\n")

# ============================================
