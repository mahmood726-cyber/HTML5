// ========================
// DATA MANAGEMENT
// ========================
function addStudy(data = {}) {
    const study = {
        id: Date.now(),
        name: data.name || `Study ${studies.length + 1}`,
        tp: data.tp ?? '',
        fp: data.fp ?? '',
        fn: data.fn ?? '',
        tn: data.tn ?? '',
        quadas: {
            patient: 'low',
            index: 'low',
            reference: 'low',
            flow: 'low'
        }
    };
    studies.push(study);
    renderDataTable();
    updateQuickStats();
    return study;
}

function removeStudy(id) {
    studies = studies.filter(s => s.id !== id);
    renderDataTable();
    updateQuickStats();
}

/**
 * Update a study's field value with validation and debounced rendering
 * @param {number} id - Study ID
 * @param {string} field - Field name to update
 * @param {string|number} value - New value
 */
function updateStudy(id, field, value) {
    const study = studies.find(s => s.id === id);
    if (!study) return;

    if (field === 'name') {
        study[field] = validateStudyName(value);
    } else {
        const validated = validateNumericInput(value);
        if (validated === null) {
            showToast('Invalid value: must be a non-negative integer', 'error');
            return;
        }
        study[field] = validated;
    }

    // Debounce rendering for better performance
    clearTimeout(renderTimeout);
    renderTimeout = setTimeout(() => {
        renderDataTable();
        updateQuickStats();
    }, STAT_CONSTANTS.DEBOUNCE_DELAY);
}

/**
 * Render the data entry table with escaped HTML for XSS protection
 */
function renderDataTable() {
    const tbody = document.getElementById('dataBody');
    tbody.innerHTML = studies.map(study => {
        const sens = calcSensitivity(study);
        const spec = calcSpecificity(study);
        const escapedName = escapeHtml(study.name);
        return `
            <tr>
                <td><input type="text" value="${escapedName}" maxlength="${STAT_CONSTANTS.MAX_STUDY_NAME_LENGTH}" onchange="updateStudy(${study.id}, 'name', this.value)" aria-label="Study name"></td>
                <td><input type="number" min="0" max="${STAT_CONSTANTS.MAX_CELL_VALUE}" value="${study.tp}" onchange="updateStudy(${study.id}, 'tp', this.value)" aria-label="True positives"></td>
                <td><input type="number" min="0" max="${STAT_CONSTANTS.MAX_CELL_VALUE}" value="${study.fp}" onchange="updateStudy(${study.id}, 'fp', this.value)" aria-label="False positives"></td>
                <td><input type="number" min="0" max="${STAT_CONSTANTS.MAX_CELL_VALUE}" value="${study.fn}" onchange="updateStudy(${study.id}, 'fn', this.value)" aria-label="False negatives"></td>
                <td><input type="number" min="0" max="${STAT_CONSTANTS.MAX_CELL_VALUE}" value="${study.tn}" onchange="updateStudy(${study.id}, 'tn', this.value)" aria-label="True negatives"></td>
                <td style="font-family: var(--font-mono); color: var(--sensitivity);">${sens !== null ? (sens * 100).toFixed(1) + '%' : '—'}</td>
                <td style="font-family: var(--font-mono); color: var(--specificity);">${spec !== null ? (spec * 100).toFixed(1) + '%' : '—'}</td>
                <td><button class="delete-btn" onclick="removeStudy(${study.id})" aria-label="Remove study">×</button></td>
            </tr>
        `;
    }).join('');

    renderQUADASGrid();
}

function calcSensitivity(study) {
    if (study.tp === '' || study.fn === '') return null;
    const denom = study.tp + study.fn;
    return denom > 0 ? study.tp / denom : null;
}

function calcSpecificity(study) {
    if (study.fp === '' || study.tn === '') return null;
    const denom = study.fp + study.tn;
    return denom > 0 ? study.tn / denom : null;
}

function updateQuickStats() {
    const validStudies = studies.filter(s => s.tp !== '' && s.fp !== '' && s.fn !== '' && s.tn !== '');
    let totalPatients = 0, totalDiseased = 0, totalHealthy = 0;
    
    validStudies.forEach(s => {
        totalPatients += s.tp + s.fp + s.fn + s.tn;
        totalDiseased += s.tp + s.fn;
        totalHealthy += s.fp + s.tn;
    });
    
    document.getElementById('statStudies').textContent = validStudies.length;
    document.getElementById('statPatients').textContent = totalPatients.toLocaleString();
    document.getElementById('statDiseased').textContent = totalDiseased.toLocaleString();
    document.getElementById('statHealthy').textContent = totalHealthy.toLocaleString();
}

