    html += `<p><strong>Range (LOO):</strong> Sens = ${(results.summary.sensRange[0] * 100).toFixed(1)}-${(results.summary.sensRange[1] * 100).toFixed(1)}%, `;
    html += `Spec = ${(results.summary.specRange[0] * 100).toFixed(1)}-${(results.summary.specRange[1] * 100).toFixed(1)}%</p>`;

    if (results.influential.length > 0) {
