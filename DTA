fit_hsroc <- reitsma(data, method = "ml", correction.control = "all")
summary(fit_hsroc)

# Extract HSROC parameters
# Lambda = accuracy parameter (higher = better discrimination)
# Theta = threshold parameter (0 = symmetric operating point)
# Beta = shape/asymmetry parameter
hsroc_params <- SummaryPts(fit_hsroc)
cat("\\n=== HSROC Parameters ===\\n")
cat("Lambda (accuracy):", round(hsroc_params$Lambda, 4), "\\n")
cat("Theta (threshold):", round(hsroc_params$Theta, 4), "\\n")
