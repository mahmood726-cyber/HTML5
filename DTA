                flow: 'low'
            }
        };
        studies.push(study);
        History.save();
        Storage.autoSave();
        renderDataTable();
        updateQuickStats();
        return study;
    } catch (e) {
        console.error('Error adding study:', e);
        showToast('Error adding study', 'error');
        return null;
    }
}

function removeStudy(id) {
    try {
        const index = studies.findIndex(s => s.id === id);
        if (index === -1) return;
        studies.splice(index, 1);
        History.save();
        Storage.autoSave();
        renderDataTable();
        updateQuickStats();
    } catch (e) {
        console.error('Error removing study:', e);
        showToast('Error removing study', 'error');
    }
}

function updateStudy(id, field, value) {
    try {
        const study = studies.find(s => s.id === id);
        if (!study) return;

        if (field === 'name') {
            study[field] = Security.sanitizeName(value);
        } else {
            const numValue = Security.sanitizeNumber(value, null);
            if (numValue === null && value !== '' && value !== null) {
                showToast('Values must be non-negative numbers', 'error');
                return;
            }
            study[field] = numValue === null ? '' : numValue;
        }

        History.save();
        Storage.autoSave();
        renderDataTable();
        updateQuickStats();
    } catch (e) {
        console.error('Error updating study:', e);
        showToast('Error updating study', 'error');
    }
}

