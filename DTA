<script>
// ========================
// CONSTANTS
// ========================
const STAT_CONSTANTS = {
    LOGIT_BOUND_LOW: 0.0001,
    LOGIT_BOUND_HIGH: 0.9999,
    Z_95: 1.96,
    Z_99: 2.576,
    Z_90: 1.645,
    CONTINUITY_CORRECTION: 0.5,
    MIN_STUDIES_BIVARIATE: 3,
    MIN_STUDIES_SROC: 2,
    MIN_STUDIES_UNIVARIATE: 2,
    MAX_STUDY_NAME_LENGTH: 100,
    MAX_CELL_VALUE: 1e9,
    DEBOUNCE_DELAY: 150
};

// ========================
// GLOBAL STATE
// ========================
let studies = [];
let results = null;
let quadasData = {};
let renderTimeout = null;
let currentModel = 'bivariate';
let currentCILevel = 0.95;

/**
 * Get the Z-score for the current confidence interval level
 * @returns {number} Z-score for the selected CI level
 */
function getCurrentZScore() {
    const ciSelect = document.getElementById('ciSelect');
    if (ciSelect) {
        currentCILevel = parseFloat(ciSelect.value);
    }
    switch (currentCILevel) {
        case 0.90: return STAT_CONSTANTS.Z_90;
        case 0.99: return STAT_CONSTANTS.Z_99;
        default: return STAT_CONSTANTS.Z_95;
    }
}

/**
 * Get CI level as percentage string for display
 * @returns {string} CI level as percentage
 */
function getCILevelDisplay() {
    return Math.round(currentCILevel * 100) + '%';
}

// ========================
// UTILITY FUNCTIONS
// ========================

/**
 * Escape HTML special characters to prevent XSS attacks
 * @param {string} str - String to escape
 * @returns {string} Escaped string safe for HTML insertion
 */
function escapeHtml(str) {
    if (str === null || str === undefined) return '';
    const div = document.createElement('div');
    div.textContent = String(str);
    return div.innerHTML;
}

/**
 * Validate and parse numeric input for cell values
 * @param {string|number} value - Input value to validate
 * @returns {number|string} Validated number, empty string if blank, or null if invalid
 */
function validateNumericInput(value) {
    if (value === '' || value === null || value === undefined) return '';
    const num = parseFloat(value);
    if (isNaN(num) || num < 0 || num > STAT_CONSTANTS.MAX_CELL_VALUE) return null;
    return Math.floor(num); // Cell counts must be integers
}

/**
 * Validate study name input
 * @param {string} name - Study name to validate
 * @returns {string} Sanitized study name
 */
function validateStudyName(name) {
    if (!name || typeof name !== 'string') return 'Unnamed Study';
    return name.substring(0, STAT_CONSTANTS.MAX_STUDY_NAME_LENGTH).trim() || 'Unnamed Study';
}

/**
 * Escape a string for CSV output (handles quotes and commas)
 * @param {string} str - String to escape
 * @returns {string} CSV-safe escaped string
 */
function escapeCSV(str) {
    if (str === null || str === undefined) return '';
    const s = String(str);
    // If contains comma, quote, or newline, wrap in quotes and escape internal quotes
    if (s.includes(',') || s.includes('"') || s.includes('\n') || s.includes('\r')) {
        return '"' + s.replace(/"/g, '""') + '"';
    }
    return s;
}

/**
 * Escape a string for R code output
 * @param {string} str - String to escape
 * @returns {string} R-safe escaped string
 */
function escapeRString(str) {
    if (str === null || str === undefined) return '';
    return String(str).replace(/\\/g, '\\\\').replace(/"/g, '\\"');
}

// ========================
// THEME TOGGLE
// ========================
function toggleTheme() {
