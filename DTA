function showToast(message, type = 'info') {
    const toast = document.getElementById('toast');
    toast.textContent = message;
    toast.classList.add('show');
    
    setTimeout(() => {
        toast.classList.remove('show');
    }, 3000);
}

// Check if Plotly is available
function isPlotlyReady() {
    return typeof Plotly !== 'undefined';
}

// Safe plot function wrapper
function safePlot(elementId, data, layout, config) {
    if (!isPlotlyReady()) {
        console.warn('Plotly not loaded yet');
        return;
    }
    try {
        Plotly.newPlot(elementId, data, layout, config || { responsive: true });
    } catch (e) {
        console.error('Plot error:', e);
    }
}

