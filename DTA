    // Use cached DOM references
    DOM.get('statStudies').textContent = validCount;
    DOM.get('statPatients').textContent = totalPatients.toLocaleString();
    DOM.get('statDiseased').textContent = totalDiseased.toLocaleString();
    DOM.get('statHealthy').textContent = totalHealthy.toLocaleString();
